private def nagChain : List ℕ := [29, 31, 37, 43, 47, 53, 61, 73, 83, 97, 113, 131, 157, 181, 211, 251, 293, 349, 409, 487, 577, 691, 829, 991, 1187, 1423, 1699, 2029, 2423, 2903, 3469, 4159, 4987, 5981, 7177, 8609, 10321, 12379, 14851, 17807, 21347, 25609, 30727, 36871, 44221, 53051, 63659, 76387, 91639, 109961, 131947, 158329, 189989, 227977, 273569, 328277, 393931, 472711, 567209, 680633, 816743, 980081, 1176089, 1411297, 1693553, 2032253]

/-- Consecutive ratio check `5 b < 6 a` along a list. -/
private def nagStepOK : List ℕ → Bool
  | a :: b :: t => decide (5 * b < 6 * a) && nagStepOK (b :: t)
  | _ => true

/-- The last entry of `a :: L`. -/
private def nagTop : ℕ → List ℕ → ℕ
  | a, [] => a
  | _, b :: t => nagTop b t

private theorem nag_cover : ∀ (L : List ℕ) (a : ℕ), (∀ q ∈ L, Nat.Prime q) →
    nagStepOK (a :: L) = true → ∀ x : ℕ, a ≤ x → x < nagTop a L →
      ∃ p : ℕ, Nat.Prime p ∧ x < p ∧ 5 * p < 6 * x := by
  intro L
  induction L with
  | nil => intro a _ _ x hax hx; simp [nagTop] at hx; omega
  | cons b t ih =>
    intro a hpr hok x hax hx
    simp only [nagStepOK, Bool.and_eq_true, decide_eq_true_eq] at hok
    by_cases hxb : x < b
    · exact ⟨b, hpr b (by simp), hxb, by omega⟩
    · exact ih b (fun q hq => hpr q (by simp [hq])) hok.2 x (by omega) (by simpa [nagTop] using hx)

private theorem nag_primes : ∀ q ∈ nagChain.tail, Nat.Prime q := by
