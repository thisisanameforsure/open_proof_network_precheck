import Mathlib
import Nodes.«variant-72919549».Context

open Nat

private lemma e849f_choose_mono_right {n i j : ℕ} (hij : i ≤ j) (hj : 2 * j ≤ n) :
    n.choose i ≤ n.choose j := by
  induction j with
  | zero =>
    have : i = 0 := by omega
    subst this; exact le_rfl
  | succ j ih =>
    rcases Nat.lt_or_ge j i with h | h
    · have : i = j + 1 := by omega
      subst this; exact le_rfl
    · exact (ih h (by omega)).trans (Nat.choose_le_succ_of_lt_half_left (by omega))

private lemma e849f_le_choose {n k : ℕ} (hk : 1 ≤ k) (hkn : 2 * k ≤ n) : n ≤ n.choose k := by
  have := e849f_choose_mono_right (n := n) hk hkn
  simpa using this

/- Arbitrarily large solutions of `b ^ 2 = a * b + a ^ 2 + 1` (consecutive Fibonacci numbers
`F (2i), F (2i+1)`), generated by `(a, b) ↦ (a + b, a + 2b)`. -/
private lemma e849f_pairs (N : ℕ) : ∃ a b : ℕ, N + 1 ≤ a ∧ b ^ 2 = a * b + a ^ 2 + 1 := by
  induction N with
  | zero => exact ⟨1, 2, le_rfl, by norm_num⟩
  | succ N ih =>
    obtain ⟨a, b, ha, h⟩ := ih
    have hb : 1 ≤ b := by
      rcases Nat.eq_zero_or_pos b with hb | hb
      · subst hb; simp at h
      · exact hb
    refine ⟨a + b, a + 2 * b, by omega, ?_⟩
    nlinarith [h]

/- The polynomial identity behind `C(n, k) = C(n - 1, k + 1)` with `n = (a+b)(a+2b)`,
`k = a(a+2b)`. -/
private lemma e849f_poly {a b : ℕ} (h : b ^ 2 = a * b + a ^ 2 + 1) :
    (a + b) * (a + 2 * b) * (a * (a + 2 * b) + 1) + b * (a + 2 * b) =
      b * (a + 2 * b) * (b * (a + 2 * b)) := by
  have hz : ((b : ℤ)) ^ 2 = a * b + a ^ 2 + 1 := by exact_mod_cast h
  have : ((a : ℤ) + b) * (a + 2 * b) * (a * (a + 2 * b) + 1) + b * (a + 2 * b) =
      b * (a + 2 * b) * (b * (a + 2 * b)) := by
    linear_combination (-((a : ℤ) + 2 * b) ^ 2) * hz
  exact_mod_cast this

/- `C(m + 1, k) = C(m, k + 1)` once `(m + 1)(k + 1) = (m - k)(m + 1 - k)` and `k < m`. -/
private lemma e849f_choose_eq {m k : ℕ} (hkm : k < m)
    (h : (m + 1) * (k + 1) = (m - k) * (m + 1 - k)) :
    (m + 1).choose k = m.choose (k + 1) := by
  have h1 := Nat.choose_mul_succ_eq m k
  have h2 := Nat.choose_succ_right_eq m k
  have hpos : 0 < (m + 1 - k) * (k + 1) := Nat.mul_pos (by omega) (by omega)
  apply Nat.eq_of_mul_eq_mul_right hpos
  calc (m + 1).choose k * ((m + 1 - k) * (k + 1))
      = ((m + 1).choose k * (m + 1 - k)) * (k + 1) := by ring
    _ = (m.choose k * (m + 1)) * (k + 1) := by rw [h1]
    _ = m.choose k * ((m + 1) * (k + 1)) := by ring
    _ = m.choose k * ((m - k) * (m + 1 - k)) := by rw [h]
    _ = (m.choose k * (m - k)) * (m + 1 - k) := by ring
    _ = (m.choose (k + 1) * (k + 1)) * (m + 1 - k) := by rw [h2]
    _ = m.choose (k + 1) * ((m + 1 - k) * (k + 1)) := by ring

/-- Infinitely many integers $a$ are $\binom{n}{k}$ with $1 \le k \le n/2$ in at least three rows
$n$: for every $N$ there is such an $a \ge N$. A consequence of the affirmative answer to
Erdős 849 (it gives one $a$ for each $t \ge 3$, all distinct). The proof uses Singmaster's
Fibonacci family: for $i \ge 1$, $n = F_{2i+2}F_{2i+3}$ and $k = F_{2i}F_{2i+3}$ give
$\binom{n}{k} = \binom{n-1}{k+1}$, and with $\binom{a}{1}$ that is three rows. -/
theorem Opn.erdos_849_three_rows_infinitely_often :
    ∀ N : ℕ, ∃ a ≥ N, 3 ≤ {n : ℕ | ∃ k ≥ 1, 2 * k ≤ n ∧ choose n k = a}.ncard := by
  intro N
  obtain ⟨a, b, ha, h⟩ := e849f_pairs N
  have hb : a < b := by nlinarith [h]
  set c := a + 2 * b with hc
  have hpoly := e849f_poly h
  rw [← hc] at hpoly
  -- n = (a + b) * c = m + 1, k = a * c
  set k := a * c with hk
  set n := (a + b) * c with hn
  have hbc : 1 ≤ b * c := Nat.mul_pos (by omega) (by omega)
  have hnk : n = k + b * c := by rw [hn, hk]; ring
  have hc5 : 5 ≤ c := by omega
  have hk5 : 5 ≤ k := by
    have : 1 * 5 ≤ a * c := Nat.mul_le_mul (by omega) hc5
    omega
  have hgap : 3 ≤ (b - a) * c := by
    have : 1 * 5 ≤ (b - a) * c := Nat.mul_le_mul (by omega) hc5
    omega
  have hbca : b * c = a * c + (b - a) * c := by
    rw [← Nat.add_mul]; congr 1; omega
  obtain ⟨m, hm⟩ : ∃ m, n = m + 1 := ⟨n - 1, by omega⟩
  have hkm : k < m := by omega
  have hrel : (m + 1) * (k + 1) = (m - k) * (m + 1 - k) := by
    have e1 : m + 1 - k = b * c := by omega
    have e2 : m - k = b * c - 1 := by omega
    rw [e1, e2, ← hm, hn, hk]
    have : b * c * (b * c) = b * c * (b * c - 1) + b * c := by
      rw [Nat.mul_sub, Nat.mul_one, Nat.sub_add_cancel (Nat.le_mul_of_pos_right _ (by omega))]
    have : (a + b) * c * (a * c + 1) + b * c = b * c * (b * c - 1) + b * c := by
      rw [hpoly]; exact this
    have := Nat.add_right_cancel this
    rw [this, Nat.mul_comm]
  have hchoose : n.choose k = m.choose (k + 1) := by
    rw [hm]; exact e849f_choose_eq hkm hrel
  set v := n.choose k with hv
  -- v is large
  have hn2 : 2 * k ≤ n := by omega
  have hvn : n < v := by
    have h2 : n.choose 2 ≤ n.choose k := e849f_choose_mono_right (by omega) hn2
    have h3 := Nat.choose_succ_right_eq n 1
    simp only [Nat.choose_one_right] at h3
    have : n * 4 ≤ n * (n - 1) := Nat.mul_le_mul_left _ (by omega)
    have h22 : n.choose (1 + 1) * 2 = n * (n - 1) := by simpa using h3
    have : n.choose 2 * 2 = n * (n - 1) := h22
    omega
  have hna : a ≤ n := le_trans (Nat.le_add_right a b) (Nat.le_mul_of_pos_right _ (by omega))
  refine ⟨v, by omega, ?_⟩
  have hsub : ({m, n, v} : Set ℕ) ⊆ {n : ℕ | ∃ k ≥ 1, 2 * k ≤ n ∧ choose n k = v} := by
    intro x hx
    simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hx
    rcases hx with rfl | rfl | rfl
    · exact ⟨k + 1, by omega, by omega, hchoose.symm⟩
    · exact ⟨k, by omega, hn2, rfl⟩
    · exact ⟨1, le_rfl, by omega, Nat.choose_one_right _⟩
  have hfin : {n : ℕ | ∃ k ≥ 1, 2 * k ≤ n ∧ choose n k = v}.Finite := by
    apply (Set.finite_Iic v).subset
    rintro x ⟨j, hj, hjx, hjv⟩
    have := e849f_le_choose hj hjx
    simp only [Set.mem_Iic]; omega
  have h3 : ({m, n, v} : Set ℕ).ncard = 3 := by
    rw [Set.ncard_eq_three]
    exact ⟨m, n, v, by omega, by omega, by omega, rfl⟩
  rw [← h3]
  exact Set.ncard_le_ncard hsub hfin
