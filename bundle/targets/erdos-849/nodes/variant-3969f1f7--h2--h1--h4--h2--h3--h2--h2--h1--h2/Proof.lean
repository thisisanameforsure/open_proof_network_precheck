-- This is the right-hand side of Mathlib's Nat.prime_def_lt'.
private def PrimeByDivisors (p : Nat) : Prop :=
  2 ≤ p ∧ ∀ d, 2 ≤ d → d < p → ¬ d ∣ p

private def intervalLcm (start : Nat) : Nat → Nat
  | 0 => start
  | depth + 1 =>
    Nat.lcm (intervalLcm start depth) (intervalLcm (start + 2 ^ depth) depth)

private theorem dvd_intervalLcm (d start depth : Nat)
    (lo : start ≤ d) (hi : d < start + 2 ^ depth) :
    d ∣ intervalLcm start depth := by
  induction depth generalizing start with
  | zero =>
    simp only [Nat.pow_zero] at hi
    have heq : d = start := by omega
    subst d
    exact Nat.dvd_refl start
  | succ depth ih =>
    change d ∣ Nat.lcm (intervalLcm start depth) (intervalLcm (start + 2 ^ depth) depth)
    rw [Nat.pow_succ] at hi
    by_cases h : d < start + 2 ^ depth
    · exact Nat.dvd_trans (ih start lo h) (Nat.dvd_lcm_left _ _)
    · exact Nat.dvd_trans (ih _ (by omega) (by omega)) (Nat.dvd_lcm_right _ _)

