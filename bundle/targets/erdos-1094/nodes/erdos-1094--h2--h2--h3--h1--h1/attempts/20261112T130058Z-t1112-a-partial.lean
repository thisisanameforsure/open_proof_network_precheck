theorem erdos_1094__h2__h2__h3__h1__h1 : ∃ (K : ℕ),
  ∀ (n k : ℕ),
    (0 : ℕ) < k →
      k * k * k ≤ n →
        Real.exp (Real.log (↑k : ℝ) ^ (2 : ℕ) / ((20 : ℝ) * Real.log (Real.log (↑k : ℝ)))) < (↑n : ℝ) + (1 : ℝ) →
          k * (n / k) ∣ k.factorial → (n.choose k).minFac > n / k → Nat.Prime (n / n.gcd k) → ¬k ∣ n → k ≤ K := by
  -- approach: Residue form of the leaf: minFac C(n,k) > n/k means no carry adding k and n-k in base p at every prime p ≤ k (k mod p^i ≤ n mod p^i for all i, Kummer) and n mod p ≥ k at every prime k < p ≤ n/k; both proved here, and the one hole keeps n ≥ k³, the exp bound, k·⌊n/k⌋ ∣ k!, n/gcd(n,k) prime, k ∤ n.
  -- licence: CC-BY-4.0
  -- label: residue form beyond van Doorn–Tang
  -- claim: $\exists K\ \forall n,k:\ 0<k,\ k^3\le n,\ \exp\bigl(\log^2 k/(20\log\log k)\bigr)<n+1,\ k\lfloor n/k\rfloor\mid k!,\ (\forall p\le k\text{ prime},\ \forall i:\ k\bmod p^i\le n\bmod p^i),\ (\forall p\text{ prime},\ k<p\le\lfloor n/k\rfloor:\ k\le n\bmod p),\ n/\gcd(n,k)\text{ prime},\ k\nmid n\ \Rightarrow\ k\le K$
  -- The leaf's hypothesis on the least prime factor of C(n,k) is replaced by the two residue facts it amounts to: at every prime p ≤ k the base-p digits of k are at most those of n (no carry adding k and n-k, Kummer), and n mod p ≥ k at every prime k < p ≤ ⌊n/k⌋ (no multiple of p among n-k+1..n).
  have h_residue : ∃ (K : ℕ), ∀ (n k : ℕ), (0 : ℕ) < k → k * k * k ≤ n →
      Real.exp (Real.log (↑k : ℝ) ^ (2 : ℕ) / ((20 : ℝ) * Real.log (Real.log (↑k : ℝ)))) < (↑n : ℝ) + (1 : ℝ) →
      k * (n / k) ∣ k.factorial → (∀ p : ℕ, p.Prime → p ≤ k → ∀ i : ℕ, k % p ^ i ≤ n % p ^ i) →
      (∀ p : ℕ, p.Prime → k < p → p ≤ n / k → k ≤ n % p) → Nat.Prime (n / n.gcd k) → ¬k ∣ n → k ≤ K := sorry
  -- Kummer: a prime p ≤ k not dividing C(n,k) carries nowhere, so each base-p digit of k is at most n's.
  have kummer : ∀ (n k p : ℕ), p.Prime → k ≤ n → ¬ p ∣ n.choose k → ∀ i : ℕ, k % p ^ i ≤ n % p ^ i := by
    intro n k p hp hkn hnd
    intro i
    have hb : Nat.log p n < Nat.log p n + 1 + i := by omega
    have hmul := Nat.Prime.emultiplicity_choose hp hkn hb
    have h0 : emultiplicity p (n.choose k) = 0 := by
      rw [emultiplicity_eq_zero]; exact hnd
    rw [h0] at hmul
    have hcard : ((Finset.Ico 1 (Nat.log p n + 1 + i)).filter
        fun j => p ^ j ≤ k % p ^ j + (n - k) % p ^ j).card = 0 := by
      exact_mod_cast hmul.symm
    rw [Finset.card_eq_zero, Finset.filter_eq_empty_iff] at hcard
    rcases Nat.eq_zero_or_pos i with hi | hi
    · subst hi; simp [Nat.mod_one]
    have hmem : i ∈ Finset.Ico 1 (Nat.log p n + 1 + i) := Finset.mem_Ico.2 ⟨hi, by omega⟩
    have hlt : k % p ^ i + (n - k) % p ^ i < p ^ i := by
      have := hcard hmem; push_neg at this; exact this
    have hsum : n = k + (n - k) := by omega
    have hpos : 0 < p ^ i := pow_pos hp.pos i
    calc k % p ^ i ≤ k % p ^ i + (n - k) % p ^ i := Nat.le_add_right _ _
      _ = (k % p ^ i + (n - k) % p ^ i) % p ^ i := (Nat.mod_eq_of_lt hlt).symm
      _ = (k + (n - k)) % p ^ i := (Nat.add_mod _ _ _).symm
      _ = n % p ^ i := by rw [← hsum]
  obtain ⟨K, hK⟩ := h_residue
  refine ⟨K, fun n k hk hn hT hfac hmin hprime hndvd => hK n k hk hn hT hfac ?_ ?_ hprime hndvd⟩
  · -- a prime p ≤ k is at most n / k, so it does not divide C(n,k); then Kummer
    intro p hp hpk
    have h2 : k ≤ n / k := (Nat.le_div_iff_mul_le hk).2 (le_trans (Nat.le_mul_of_pos_right _ hk) hn)
    have hkn : k ≤ n := le_trans h2 (Nat.div_le_self n k)
    refine kummer n k p hp hkn ?_
    intro hpd
    have h1 := Nat.minFac_le_of_dvd hp.two_le hpd
    omega
  · -- a prime k < p ≤ n / k with n mod p < k divides n - n mod p, one of n-k+1..n, hence C(n,k)
    intro p hp hkp hpB
    by_contra hlt
    have hlt : n % p < k := Nat.lt_of_not_le hlt
    have hpd : p ∣ n.choose k := by
      have hdiv : p ∣ k.factorial * n.choose k := by
        rw [← Nat.descFactorial_eq_factorial_mul_choose, Nat.descFactorial_eq_prod_range]
        have hj : n % p ∈ Finset.range k := Finset.mem_range.2 hlt
        have h1 := Finset.dvd_prod_of_mem (fun i => n - i) hj
        exact dvd_trans (Nat.dvd_sub_mod n) h1
      rcases (Nat.Prime.dvd_mul hp).1 hdiv with h | h
      · exact absurd ((Nat.Prime.dvd_factorial hp).1 h) (by omega)
      · exact h
    have := Nat.minFac_le_of_dvd hp.two_le hpd
    omega
