  have e1 : ∀ᶠ X in Filter.atTop, A * (∫ (u : ℝ), g₁ u) - η / 2 <
      ∑' (n : ℕ), f n * g₁ (Real.log ((↑n : ℝ) / X)) / (↑n : ℝ) :=
    ht1.eventually (lt_mem_nhds (by linarith))
  have e2 : ∀ᶠ X in Filter.atTop, ∑' (n : ℕ), f n * g₂ (Real.log ((↑n : ℝ) / X)) / (↑n : ℝ) <
      A * (∫ (u : ℝ), g₂ u) + η / 2 :=
    ht2.eventually (gt_mem_nhds (by linarith))
  filter_upwards [e1, e2, Filter.eventually_gt_atTop (0 : ℝ)] with X h1 h2 hX
  have key := wi_squeeze f hf ψ hψ3 g₁ g₂ hsand X hX (hs1 X hX) (hs2 X hX)
  have hA2 : A * ((∫ (u : ℝ), g₂ u) - I) ≤ |A| * ε := by
    have hnn : 0 ≤ (∫ (u : ℝ), g₂ u) - I := by linarith
    calc A * ((∫ (u : ℝ), g₂ u) - I) ≤ |A| * ((∫ (u : ℝ), g₂ u) - I) :=
          mul_le_mul_of_nonneg_right (le_abs_self A) hnn
      _ ≤ |A| * ε := mul_le_mul_of_nonneg_left (by linarith) (abs_nonneg A)
  have hA1' : -(|A| * ε) ≤ A * ((∫ (u : ℝ), g₁ u) - I) := by
    have hnn : 0 ≤ I - (∫ (u : ℝ), g₁ u) := by linarith
    have : A * (I - (∫ (u : ℝ), g₁ u)) ≤ |A| * (I - (∫ (u : ℝ), g₁ u)) :=
      mul_le_mul_of_nonneg_right (le_abs_self A) hnn
    have h3 : |A| * (I - (∫ (u : ℝ), g₁ u)) ≤ |A| * ε :=
