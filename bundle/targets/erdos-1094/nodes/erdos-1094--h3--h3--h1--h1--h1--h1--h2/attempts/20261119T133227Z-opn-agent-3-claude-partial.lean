private theorem wi_term (f : ℕ → ℝ) (ψ : ℝ → ℝ) (hψ3 : Function.support ψ ⊆ Set.Ioi (0 : ℝ))
    (X : ℝ) (hX : 0 < X) (n : ℕ) :
    f n * ψ ((↑n : ℝ) / X) / X =
      f n * (Real.exp (Real.log ((↑n : ℝ) / X)) * ψ (Real.exp (Real.log ((↑n : ℝ) / X)))) / (↑n : ℝ) := by
  rcases Nat.eq_zero_or_pos n with h0 | hpos
  · subst h0
    have : ψ 0 = 0 := by
      by_contra h
      have := hψ3 (Function.mem_support.2 h)
      exact lt_irrefl (0 : ℝ) (Set.mem_Ioi.1 this)
    simp [this]
  · have hn : (0 : ℝ) < (↑n : ℝ) := by exact_mod_cast hpos
    have hq : (0 : ℝ) < (↑n : ℝ) / X := div_pos hn hX
    rw [Real.exp_log hq]
    field_simp

private theorem wi_squeeze (f : ℕ → ℝ) (hf : ∀ (n : ℕ), (0 : ℝ) ≤ f n) (ψ : ℝ → ℝ)
    (hψ3 : Function.support ψ ⊆ Set.Ioi (0 : ℝ)) (g₁ g₂ : ℝ → ℝ)
    (hsand : ∀ (u : ℝ), g₁ u ≤ Real.exp u * ψ (Real.exp u) ∧ Real.exp u * ψ (Real.exp u) ≤ g₂ u)
    (X : ℝ) (hX : 0 < X)
    (hs1 : Summable (fun (n : ℕ) => f n * g₁ (Real.log ((↑n : ℝ) / X)) / (↑n : ℝ)))
    (hs2 : Summable (fun (n : ℕ) => f n * g₂ (Real.log ((↑n : ℝ) / X)) / (↑n : ℝ))) :
    ∑' (n : ℕ), f n * g₁ (Real.log ((↑n : ℝ) / X)) / (↑n : ℝ) ≤ (∑' (n : ℕ), f n * ψ ((↑n : ℝ) / X)) / X ∧
    (∑' (n : ℕ), f n * ψ ((↑n : ℝ) / X)) / X ≤ ∑' (n : ℕ), f n * g₂ (Real.log ((↑n : ℝ) / X)) / (↑n : ℝ) := by
  set b : ℕ → ℝ := fun n => f n * (Real.exp (Real.log ((↑n : ℝ) / X)) *
    ψ (Real.exp (Real.log ((↑n : ℝ) / X)))) / (↑n : ℝ) with hb
  have hmid : (∑' (n : ℕ), f n * ψ ((↑n : ℝ) / X)) / X = ∑' (n : ℕ), b n := by
    rw [← tsum_div_const]
    exact tsum_congr (fun n => wi_term f ψ hψ3 X hX n)
  have hl : ∀ n : ℕ, f n * g₁ (Real.log ((↑n : ℝ) / X)) / (↑n : ℝ) ≤ b n := fun n =>
    div_le_div_of_nonneg_right (mul_le_mul_of_nonneg_left (hsand _).1 (hf n)) (Nat.cast_nonneg n)
  have hu : ∀ n : ℕ, b n ≤ f n * g₂ (Real.log ((↑n : ℝ) / X)) / (↑n : ℝ) := fun n =>
    div_le_div_of_nonneg_right (mul_le_mul_of_nonneg_left (hsand _).2 (hf n)) (Nat.cast_nonneg n)
  have hdiff : Summable (fun n => b n - f n * g₁ (Real.log ((↑n : ℝ) / X)) / (↑n : ℝ)) :=
    Summable.of_nonneg_of_le (fun n => sub_nonneg.2 (hl n))
      (fun n => sub_le_sub_right (hu n) _) (hs2.sub hs1)
  have hbs : Summable b := by
    have := hdiff.add hs1
    simpa using this
  rw [hmid]
  exact ⟨hs1.tsum_le_tsum hl hbs, hbs.tsum_le_tsum hu hs2⟩

theorem erdos_1094__h3__h3__h1__h1__h1__h1__h2 : ∀ (f : ℕ → ℝ) (A : ℝ),
  (∀ (n : ℕ), (0 : ℝ) ≤ f n) →
    (∀ (s : ℂ), (1 : ℝ) < s.re → LSeriesSummable (fun (n : ℕ) => (↑(f n) : ℂ)) s) →
      (∃ (G : ℂ → ℂ),
          ContinuousOn G {s : ℂ | (1 : ℝ) ≤ s.re} ∧
            ∀ (s : ℂ), (1 : ℝ) < s.re → G s = LSeries (fun (n : ℕ) => (↑(f n) : ℂ)) s - (↑A : ℂ) / (s - (1 : ℂ))) →
        ∀ (ψ : ℝ → ℝ),
          ContDiff ℝ (2 : WithTop ℕ∞) ψ →
            HasCompactSupport ψ →
              Function.support ψ ⊆ Set.Ioi (0 : ℝ) →
                Filter.Tendsto (fun (X : ℝ) => (∑' (n : ℕ), f n * ψ ((↑n : ℝ) / X)) / X) Filter.atTop
                  (nhds (A * ∫ (x : ℝ), ψ x)) := by

  -- approach: band-limited Wiener–Ikehara plus a one-sided squeeze: with h(u) = e^u ψ(e^u), (1/X) Σ f(n) ψ(n/X) = Σ f(n) h(log(n/X))/n; Beurling–Selberg minorants and majorants g₁ ≤ h ≤ g₂, close in L¹, and f ≥ 0 squeeze it between sums tending to A∫g₁ and A∫g₂.
  -- licence: CC-BY-4.0
  -- label: band-limited Wiener–Ikehara
  -- claim: $f\ge0,\ F(s)-\frac{A}{s-1}\text{ continuous on }\Re s\ge1,\ g\text{ continuous},\ |g(u)|\le\frac{C}{1+u^2},\ \operatorname{supp}\hat g\text{ compact} \Rightarrow \sum_n \frac{f(n)}{n}\,g\bigl(\log\tfrac nX\bigr)\to A\int g$
  -- The Fourier-side form of the Wiener–Ikehara theorem (Korevaar, "A century of complex Tauberian theory", §III):
  -- for a continuous band-limited kernel g with quadratic decay, every weighted sum converges absolutely and tends to A ∫ g.
  have h_fourier : ∀ (f : ℕ → ℝ) (A : ℝ), (∀ (n : ℕ), (0 : ℝ) ≤ f n) →
      (∀ (s : ℂ), (1 : ℝ) < s.re → LSeriesSummable (fun (n : ℕ) => (↑(f n) : ℂ)) s) →
      (∃ (G : ℂ → ℂ), ContinuousOn G {s : ℂ | (1 : ℝ) ≤ s.re} ∧
          ∀ (s : ℂ), (1 : ℝ) < s.re → G s = LSeries (fun (n : ℕ) => (↑(f n) : ℂ)) s - (↑A : ℂ) / (s - (1 : ℂ))) →
      ∀ (g : ℝ → ℝ), Continuous g → (∃ (C : ℝ), ∀ (u : ℝ), |g u| ≤ C / (1 + u ^ 2)) →
        HasCompactSupport (FourierTransform.fourier (fun (u : ℝ) => (↑(g u) : ℂ))) →
        (∀ (X : ℝ), 0 < X → Summable (fun (n : ℕ) => f n * g (Real.log ((↑n : ℝ) / X)) / (↑n : ℝ))) ∧
        Filter.Tendsto (fun (X : ℝ) => ∑' (n : ℕ), f n * g (Real.log ((↑n : ℝ) / X)) / (↑n : ℝ)) Filter.atTop
          (nhds (A * ∫ (u : ℝ), g u)) := by
    sorry
  -- label: band-limited one-sided approximation
  -- claim: $\forall\varepsilon>0\ \exists g_1,g_2\text{ band-limited},\ |g_i(u)|\le\frac{C}{1+u^2},\ g_1(u)\le e^u\psi(e^u)\le g_2(u),\ \int g_1\le\int\psi\le\int g_2,\ \int g_2-\int g_1\le\varepsilon$
  -- Beurling–Selberg majorants and minorants (Vaaler, Bull. AMS 12 (1985)) of h(u) = e^u ψ(e^u), which is continuous,
  -- vanishes for large u and is O(e^u) as u → -∞; the integral bounds come from ∫ h = ∫ ψ.
  have h_approx : ∀ (ψ : ℝ → ℝ), ContDiff ℝ (2 : WithTop ℕ∞) ψ → HasCompactSupport ψ →
      Function.support ψ ⊆ Set.Ioi (0 : ℝ) → ∀ (ε : ℝ), 0 < ε →
      ∃ (g₁ g₂ : ℝ → ℝ),
        (Continuous g₁ ∧ (∃ (C : ℝ), ∀ (u : ℝ), |g₁ u| ≤ C / (1 + u ^ 2)) ∧
          HasCompactSupport (FourierTransform.fourier (fun (u : ℝ) => (↑(g₁ u) : ℂ)))) ∧
        (Continuous g₂ ∧ (∃ (C : ℝ), ∀ (u : ℝ), |g₂ u| ≤ C / (1 + u ^ 2)) ∧
          HasCompactSupport (FourierTransform.fourier (fun (u : ℝ) => (↑(g₂ u) : ℂ)))) ∧
        (∀ (u : ℝ), g₁ u ≤ Real.exp u * ψ (Real.exp u) ∧ Real.exp u * ψ (Real.exp u) ≤ g₂ u) ∧
        (∫ (u : ℝ), g₁ u) ≤ (∫ (x : ℝ), ψ x) ∧ (∫ (x : ℝ), ψ x) ≤ (∫ (u : ℝ), g₂ u) ∧
        (∫ (u : ℝ), g₂ u) - (∫ (u : ℝ), g₁ u) ≤ ε := by
    sorry
  intro f A hf hsum hG ψ hψ1 hψ2 hψ3
  have HF := h_fourier f A hf hsum hG
  rw [Metric.tendsto_nhds]
  intro η hη
  set I := ∫ (x : ℝ), ψ x with hI
  have hA1 : 0 < |A| + 1 := by positivity
  set ε := η / (2 * (|A| + 1)) with hεdef
  have hε : 0 < ε := by positivity
  have hεA : |A| * ε < η / 2 := by
    have h2 : ε * (2 * (|A| + 1)) = η := by rw [hεdef]; field_simp
    nlinarith [abs_nonneg A]
  obtain ⟨g₁, g₂, ⟨c1, d1, b1⟩, ⟨c2, d2, b2⟩, hsand, hI1, hI2, hgap⟩ := h_approx ψ hψ1 hψ2 hψ3 ε hε
  obtain ⟨hs1, ht1⟩ := HF g₁ c1 d1 b1
