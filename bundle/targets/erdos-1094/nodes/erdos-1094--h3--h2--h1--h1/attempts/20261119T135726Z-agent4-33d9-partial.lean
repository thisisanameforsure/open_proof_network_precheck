private lemma bhp_prime (C : ℝ) (hC : 0 < C) (k₀ : ℕ)
    (hb : ∀ (k : ℕ), k₀ ≤ k →
          C * (↑k : ℝ) ^ (21 / 40 : ℝ) / Real.log (↑k : ℝ) ≤
            (↑{p ∈ Finset.Ioo ⌊(↑k : ℝ)⌋ ⌈(↑k : ℝ) + (↑k : ℝ) ^ (21 / 40 : ℝ)⌉ |
                    (0 : ℤ) < p ∧
                      Nat.Prime p.natAbs ∧ (↑k : ℝ) < (↑p : ℝ) ∧ (↑p : ℝ) < (↑k : ℝ) + (↑k : ℝ) ^ (21 / 40 : ℝ)}.card :
              ℝ))
    (y : ℕ) (hy : k₀ ≤ y) (hy2 : 2 ≤ y) :
    ∃ q : ℕ, q.Prime ∧ (y : ℝ) < q ∧ (q : ℝ) < y + (y : ℝ) ^ (21 / 40 : ℝ) := by
  have hy0 : (1 : ℝ) < y := by exact_mod_cast (show 1 < y by omega)
  have hpos : 0 < C * (y : ℝ) ^ (21 / 40 : ℝ) / Real.log y :=
    div_pos (mul_pos hC (Real.rpow_pos_of_pos (by linarith) _)) (Real.log_pos hy0)
  have h := lt_of_lt_of_le hpos (hb y hy)
  have hcard := Nat.cast_pos.mp h
  obtain ⟨p, hp⟩ := Finset.card_pos.mp hcard
  rw [Finset.mem_filter] at hp
  obtain ⟨-, hp0, hpp, hlo, hhi⟩ := hp
  have hcast : ((p.natAbs : ℕ) : ℝ) = (p : ℝ) := by
    have : ((p.natAbs : ℕ) : ℤ) = p := Int.natAbs_of_nonneg hp0.le
    calc ((p.natAbs : ℕ) : ℝ) = (((p.natAbs : ℕ) : ℤ) : ℝ) := (Int.cast_natCast _).symm
      _ = (p : ℝ) := by rw [this]
  refine ⟨p.natAbs, hpp, ?_, ?_⟩ <;> rw [hcast] <;> assumption

private lemma carry_dvd_choose (p n k a : ℕ) (hp : p.Prime) (hk1 : p ≤ k) (hk2 : k < 2 * p)
    (ha : 2 ≤ a) (h1 : n - k < (a - 1) * p) (h2 : a * p ≤ n) : p ∣ n.choose k := by
  have hkn : k ≤ n := by
    have : 2 * p ≤ a * p := Nat.mul_le_mul_right p ha
    omega
  have : Fact p.Prime := ⟨hp⟩
  have hpn : p ≤ n := le_trans hk1 hkn
  have hlog : 1 ≤ Nat.log p n := by
    exact Nat.le_log_of_pow_le hp.one_lt (by simpa using hpn)
  have hv := padicValNat_choose (p := p) (n := n) (k := k) (b := Nat.log p n + 1) hkn (by omega)
  have hmem : 1 ∈ Finset.filter (fun i => p ^ i ≤ k % p ^ i + (n - k) % p ^ i) (Finset.Ico 1 (Nat.log p n + 1)) := by
    rw [Finset.mem_filter, Finset.mem_Ico]
    refine ⟨⟨le_rfl, by omega⟩, ?_⟩
    simp only [pow_one]
    have hkm : k % p = k - p := by
      rw [Nat.mod_eq_sub_mod hk1, Nat.mod_eq_of_lt (by omega)]
    have hdm := Nat.div_add_mod (n - k) p
    have hq : (n - k) / p < a - 1 := by
      by_contra hc
      push Not at hc
      have : (a - 1) * p ≤ p * ((n - k) / p) := by
        rw [mul_comm]; exact Nat.mul_le_mul_left p hc
      omega
    have hq2 : p * ((n - k) / p) ≤ p * (a - 2) := Nat.mul_le_mul_left p (by omega)
    have hap : a * p = p * (a - 2) + 2 * p := by
      have : a = (a - 2) + 2 := by omega
      conv_lhs => rw [this]
      ring
    rw [hkm]
    omega
  have hpos : 0 < padicValNat p (n.choose k) := by
    rw [hv]
    exact Finset.card_pos.mpr ⟨1, hmem⟩
  exact dvd_of_one_le_padicValNat hpos

private lemma rpow_bound (k : ℕ) (hk : 59049 ≤ k) : 9 * (k : ℝ) ^ (31 / 40 : ℝ) ≤ k := by
