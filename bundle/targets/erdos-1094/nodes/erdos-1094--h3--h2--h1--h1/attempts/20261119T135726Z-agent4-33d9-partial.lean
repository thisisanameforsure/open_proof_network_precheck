theorem erdos_1094__h3__h2__h1__h1 : ∃ (c : ℝ),
  (0 : ℝ) < c ∧
    ∃ (K : ℕ),
      ∀ (n k : ℕ), K < k → (2 : ℕ) * k ≤ n → n < k * k → (n.choose k).minFac > k → (↑k : ℝ) ^ ((1 : ℝ) + c) < (↑n : ℝ) := by
  -- approach: a prime p in (k/2, k] with two multiples in the window (n-k, n] divides C(n,k) (a carry in the last base-p digit); for n ≤ k^{5/4} such a p lies in an interval ((n-k)/(a-1), n/a] of length ≫ k^{3/4}, a = ⌊3n/2k⌋, so Baker–Harman–Pintz supplies one
  -- licence: CC-BY-4.0
  -- label: Baker–Harman–Pintz short-interval primes
  -- claim: $\exists C>0\ \exists k_0\ \forall k\ge k_0:\ \dfrac{C\,k^{21/40}}{\log k}\le\#\{p\ \text{prime}: k<p<k+k^{21/40}\}$
  -- Restates the node erdos-1094--h2--h2--h1 (Baker, Harman and Pintz 2001), counted over the integers in the open interval.
  have h_bhp : ∃ (C : ℝ),
      (0 : ℝ) < C ∧
        ∃ (k₀ : ℕ),
          ∀ (k : ℕ),
            k₀ ≤ k →
              C * (↑k : ℝ) ^ (21 / 40 : ℝ) / Real.log (↑k : ℝ) ≤
                (↑{p ∈ Finset.Ioo ⌊(↑k : ℝ)⌋ ⌈(↑k : ℝ) + (↑k : ℝ) ^ (21 / 40 : ℝ)⌉ |
                        (0 : ℤ) < p ∧
                          Nat.Prime p.natAbs ∧ (↑k : ℝ) < (↑p : ℝ) ∧ (↑p : ℝ) < (↑k : ℝ) + (↑k : ℝ) ^ (21 / 40 : ℝ)}.card :
                  ℝ) := sorry
  obtain ⟨C, hC, k₀, hb⟩ := h_bhp
  exact ees_main C hC k₀ hb
