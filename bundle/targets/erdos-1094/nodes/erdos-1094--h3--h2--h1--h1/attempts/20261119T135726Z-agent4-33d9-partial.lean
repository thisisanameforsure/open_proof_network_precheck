      Real.rpow_le_rpow_of_exponent_le (by norm_num) (by norm_num)
    rw [Real.rpow_one] at h3
    linarith
  have hsplit : (k : ℝ) = (k : ℝ) ^ (31 / 40 : ℝ) * (k : ℝ) ^ (9 / 40 : ℝ) := by
    rw [← Real.rpow_add hk0]; norm_num
  have hp : 0 ≤ (k : ℝ) ^ (31 / 40 : ℝ) := Real.rpow_nonneg hk0.le _
  nlinarith

private lemma short_fit (n k a y : ℕ) (hk : 59049 ≤ k)
    (hn : (n : ℝ) ≤ (k : ℝ) ^ ((1 : ℝ) + 1 / 4)) (ha : 2 * k * a ≤ 3 * n) (hy : y ≤ k)
    (hgap : k < 6 * (n - a * y)) (hay : a * y ≤ n) :
    (a : ℝ) * ((y : ℝ) + (y : ℝ) ^ (21 / 40 : ℝ)) < n := by
  have hk0 : (0 : ℝ) < k := by exact_mod_cast (show 0 < k by omega)
  have h14 : (k : ℝ) ^ ((1 : ℝ) + 1 / 4) = k * (k : ℝ) ^ (1 / 4 : ℝ) := by
    rw [Real.rpow_add hk0, Real.rpow_one]
  have ha' : (2 * k * a : ℝ) ≤ 3 * n := by exact_mod_cast ha
  have hq : 0 ≤ (k : ℝ) ^ (1 / 4 : ℝ) := Real.rpow_nonneg hk0.le _
  have haR : (a : ℝ) ≤ 3 / 2 * (k : ℝ) ^ (1 / 4 : ℝ) := by
    have : (a : ℝ) * (2 * k) ≤ (3 / 2 * (k : ℝ) ^ (1 / 4 : ℝ)) * (2 * k) := by
      rw [h14] at hn; nlinarith
    exact le_of_mul_le_mul_right this (by positivity)
  have hyR : (y : ℝ) ^ (21 / 40 : ℝ) ≤ (k : ℝ) ^ (21 / 40 : ℝ) :=
    Real.rpow_le_rpow (by positivity) (by exact_mod_cast hy) (by norm_num)
  have hprod : (k : ℝ) ^ (1 / 4 : ℝ) * (k : ℝ) ^ (21 / 40 : ℝ) = (k : ℝ) ^ (31 / 40 : ℝ) := by
    rw [← Real.rpow_add hk0]; norm_num
  have hb := rpow_bound k hk
  have hgapR : (k : ℝ) < 6 * ((n : ℝ) - a * y) := by
    have : ((n - a * y : ℕ) : ℝ) = (n : ℝ) - a * y := by push_cast [Nat.cast_sub hay]; ring
    have h := (show ((k : ℕ) : ℝ) < ((6 * (n - a * y) : ℕ) : ℝ) by exact_mod_cast hgap)
    push_cast [Nat.cast_sub hay] at h
