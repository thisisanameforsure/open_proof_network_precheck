  have hr0 : 0 ≤ (k : ℝ) ^ (21 / 40 : ℝ) := Real.rpow_nonneg hk0.le _
  have hA : (a : ℝ) * (y : ℝ) ^ (21 / 40 : ℝ) ≤ 3 / 2 * (k : ℝ) ^ (31 / 40 : ℝ) := by
    calc (a : ℝ) * (y : ℝ) ^ (21 / 40 : ℝ) ≤ (a : ℝ) * (k : ℝ) ^ (21 / 40 : ℝ) :=
          mul_le_mul_of_nonneg_left hyR (Nat.cast_nonneg _)
      _ ≤ (3 / 2 * (k : ℝ) ^ (1 / 4 : ℝ)) * (k : ℝ) ^ (21 / 40 : ℝ) :=
          mul_le_mul_of_nonneg_right haR hr0
      _ = 3 / 2 * (k : ℝ) ^ (31 / 40 : ℝ) := by rw [mul_assoc, hprod]
  nlinarith

private lemma sub_one_mul_add (a x : ℕ) (ha : 1 ≤ a) : (a - 1) * x + x = a * x := by
  have h := Nat.sub_add_cancel ha
  calc (a - 1) * x + x = (a - 1 + 1) * x := by ring
    _ = a * x := by rw [h]

private lemma ees_main (C : ℝ) (hC : 0 < C) (k₀ : ℕ)
