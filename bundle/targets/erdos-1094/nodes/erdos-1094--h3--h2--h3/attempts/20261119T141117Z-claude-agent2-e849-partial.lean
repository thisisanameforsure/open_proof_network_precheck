private lemma e1094_dvd_of_mod_lt {n k p : ℕ} (hp : p.Prime) (h : n % p < k % p) :
    p ∣ n.choose k := by
  haveI := Fact.mk hp
  have hl := Choose.choose_modEq_choose_mod_mul_choose_div_nat (n := n) (k := k) (p := p)
  rw [Nat.choose_eq_zero_of_lt h, zero_mul] at hl
  exact (Nat.modEq_zero_iff_dvd).mp hl

private lemma e1094_pow_bound {n k : ℕ} (hn : (k : ℝ) ^ (7 / 4 : ℝ) ≤ (n : ℝ)) : k ^ 7 ≤ n ^ 4 := by
  have h0 : (0 : ℝ) ≤ (k : ℝ) ^ (7 / 4 : ℝ) := by positivity
  have h1 : ((k : ℝ) ^ (7 / 4 : ℝ)) ^ (4 : ℕ) ≤ (n : ℝ) ^ (4 : ℕ) := pow_le_pow_left₀ h0 hn 4
  have h2 : ((k : ℝ) ^ (7 / 4 : ℝ)) ^ (4 : ℕ) = (k : ℝ) ^ (7 : ℕ) := by
    rw [← Real.rpow_natCast, ← Real.rpow_mul (by positivity)]
    norm_num
  rw [h2] at h1
  exact_mod_cast h1

private lemma e1094_lin {p d a a' b b' k : ℕ} (h1 : p * a + b = (p + d) * a' + b')
    (ha : a' < a) (hpk : p + d ≤ k) (hb : k - p ≤ b) (hb' : b' < p + d) : k - (p + d) + 1 ≤ d * a' := by
  have e1 : (p + d) * a' = p * a' + d * a' := by ring
  have e2 : p * a = p * a' + p * (a - a') := by
    rw [← Nat.mul_add]; congr 1; omega
  have hX : p ≤ p * (a - a') := Nat.le_mul_of_pos_right p (by omega)
  generalize p * a = A at *
  generalize p * a' = B at *
  generalize d * a' = Y at *
  generalize p * (a - a') = Z at *
  generalize (p + d) * a' = W at *
  omega

/- The elementary core: with two primes `p < q` just above `k/2` and close together, one of them
satisfies Kummer's criterion `n % p < k % p`. -/
private lemma e1094_core {n k p q c L : ℕ} (hk : 17 ≤ k) (h2p : k < 2 * p) (hpq : p < q)
    (he : 16 * (2 * q - k) ^ 4 ≤ k ^ 3) (hd : q - p ≤ c * L) (hn : k ^ 7 ≤ n ^ 4)
    (hC : 8 * c * (n * L) < k * k) : n % p < k % p ∨ n % q < k % q := by
  set e := 2 * q - k with he_def
  -- e < k / 4
  have he4 : 4 * e < k := by
    by_contra hcon
    push_neg at hcon
    have h1 : k ^ 4 ≤ (4 * e) ^ 4 := Nat.pow_le_pow_left hcon 4
    have h2 : (4 * e) ^ 4 = 16 * (16 * e ^ 4) := by ring
    have h3 : k ^ 4 ≤ 16 * k ^ 3 := by
      calc k ^ 4 ≤ 16 * (16 * e ^ 4) := h2 ▸ h1
        _ ≤ 16 * k ^ 3 := Nat.mul_le_mul_left _ he
    have h4 : k * k ^ 3 ≤ 16 * k ^ 3 := by rw [← pow_succ']; exact h3
    have h5 : 0 < k ^ 3 := pow_pos (by omega) 3
    have := Nat.le_of_mul_le_mul_right h4 h5
    omega
  have hqk : q < k := by omega
  have hpk : p < k := by omega
  have hkp : k % p = k - p := by
    rw [Nat.mod_eq_sub_mod (by omega), Nat.mod_eq_of_lt (by omega)]
  have hkq : k % q = k - q := by
    rw [Nat.mod_eq_sub_mod (by omega), Nat.mod_eq_of_lt (by omega)]
  by_contra hcon
  push_neg at hcon
  obtain ⟨hbp, hbq⟩ := hcon
  rw [hkp] at hbp
  rw [hkq] at hbq
  set a := n / p with ha
  set a' := n / q with ha'
  set b := n % p with hb
  set b' := n % q with hb'
  have hnp : p * a + b = n := Nat.div_add_mod n p
  have hnq : q * a' + b' = n := Nat.div_add_mod n q
  have hbp' : b < p := Nat.mod_lt _ (by omega)
  have hbq' : b' < q := Nat.mod_lt _ (by omega)
  have haa : a' ≤ a := Nat.div_le_div_left (le_of_lt hpq) (by omega)
  obtain ⟨d, rfl⟩ : ∃ d, q = p + d := ⟨q - p, by omega⟩
  have hd1 : 1 ≤ d := by omega
  -- a ≥ e
  have hae : e ≤ a := by
    by_contra hlt
    push_neg at hlt
    have h1 : n < p * e := by
      have : p * (a + 1) ≤ p * e := Nat.mul_le_mul_left _ hlt
      nlinarith
    have h2 : n < k * e := lt_of_lt_of_le h1 (Nat.mul_le_mul_right _ (by omega))
    have h3 : n ^ 4 < (k * e) ^ 4 := Nat.pow_lt_pow_left h2 (by norm_num)
    have h4 : 16 * (k * e) ^ 4 ≤ k ^ 7 := by
      have : 16 * (k * e) ^ 4 = k ^ 4 * (16 * e ^ 4) := by ring
      rw [this]
      calc k ^ 4 * (16 * e ^ 4) ≤ k ^ 4 * k ^ 3 := Nat.mul_le_mul_left _ he
        _ = k ^ 7 := by ring
    omega
  rcases Nat.eq_or_lt_of_le haa with heq | hlt
  · -- same quotient
    rw [heq] at hnq
    have hda : a ≤ d * a := Nat.le_mul_of_pos_left a (by omega)
    have : (p + d) * a = p * a + d * a := by ring
    omega
  · -- smaller quotient for q
    have hX : p ≤ p * (a - a') := Nat.le_mul_of_pos_right p (by omega)
    have hlow : k - (p + d) + 1 ≤ d * a' := e1094_lin (by omega) hlt (by omega) hbp hbq'
    have hup1 : d * a' * (p + d) ≤ c * L * n := by
      have h1 : a' * (p + d) ≤ n := by
        have := Nat.div_mul_le_self n (p + d); simpa [ha'] using this
      calc d * a' * (p + d) = d * (a' * (p + d)) := by ring
        _ ≤ (c * L) * n := Nat.mul_le_mul (by omega) h1
    have hup2 : d * a' * k ≤ d * a' * (2 * (p + d)) := Nat.mul_le_mul_left _ (by omega)
    have hup3 : 4 * (d * a') * k < k * k := by
      have : d * a' * (2 * (p + d)) = 2 * (d * a' * (p + d)) := by ring
      have h8 : 8 * c * (n * L) = 8 * (c * L * n) := by ring
      have h9 : 4 * (d * a') * k = 4 * (d * a' * k) := by ring
      omega
    have hup4 : 4 * (d * a') < k := Nat.lt_of_mul_lt_mul_right hup3
    omega

theorem erdos_1094__h3__h2__h3 : ∃ (C : ℕ) (K₄ : ℕ),
  ∀ (n k : ℕ),
    K₄ < k →
      (↑k : ℝ) ^ (7 / 4 : ℝ) ≤ (↑n : ℝ) →
        C * (n * Nat.log (2 : ℕ) k) < k * k → ∃ (p : ℕ), Nat.Prime p ∧ k < (2 : ℕ) * p ∧ p < k ∧ p ∣ n.choose k := by
  -- approach: Erdős–Lacampagne–Selfridge (1993), Theorem 1, the range n ≥ k^(7/4): two primes p < q in (k/2, k/2 + k^(3/4)/2] at distance at most c·log₂ k (from Ingham's count of primes in short intervals, by pigeonhole) cannot both fail Kummer's criterion n % p < k % p
  -- licence: CC-BY-4.0
  -- label: two close primes just above k/2
  -- claim: $\exists c, K\ \forall k > K\ \exists p, q \text{ prime}:\ k < 2p,\ p < q,\ 16\,(2q - k)^4 \le k^3,\ q - p \le c \log_2 k$
  -- Two primes in $(k/2,\ k/2 + k^{3/4}/2]$ whose difference is at most $c \lfloor \log_2 k \rfloor$; the bound $16(2q-k)^4 \le k^3$ is $2q - k \le k^{3/4}/2$ in natural numbers.
  have h_close : ∃ c K : ℕ, ∀ k : ℕ, K < k → ∃ p q : ℕ, p.Prime ∧ q.Prime ∧ k < 2 * p ∧ p < q ∧
      16 * (2 * q - k) ^ 4 ≤ k ^ 3 ∧ q - p ≤ c * Nat.log 2 k := sorry
  obtain ⟨c, K, hK⟩ := h_close
  refine ⟨8 * c, K + 17, ?_⟩
  intro n k hk hn hC
  obtain ⟨p, q, hp, hq, h2p, hpq, he, hd⟩ := hK k (by omega)
  have hn4 := e1094_pow_bound hn
  have he4 : 4 * (2 * q - k) < k := by
    by_contra hcon
    push_neg at hcon
    have h1 : k ^ 4 ≤ (4 * (2 * q - k)) ^ 4 := Nat.pow_le_pow_left hcon 4
    have h2 : (4 * (2 * q - k)) ^ 4 = 16 * (16 * (2 * q - k) ^ 4) := by ring
    have h3 : k * k ^ 3 ≤ 16 * k ^ 3 := by
      rw [← pow_succ']
      calc k ^ 4 ≤ 16 * (16 * (2 * q - k) ^ 4) := h2 ▸ h1
        _ ≤ 16 * k ^ 3 := Nat.mul_le_mul_left _ he
    have := Nat.le_of_mul_le_mul_right h3 (pow_pos (by omega) 3)
    omega
  rcases e1094_core (by omega) h2p hpq he hd hn4 hC with h | h
  · exact ⟨p, hp, h2p, by omega, e1094_dvd_of_mod_lt hp h⟩
  · exact ⟨q, hq, by omega, by omega, e1094_dvd_of_mod_lt hq h⟩

