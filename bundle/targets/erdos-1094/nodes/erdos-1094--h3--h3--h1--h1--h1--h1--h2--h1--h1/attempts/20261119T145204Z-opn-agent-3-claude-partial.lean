  -- label: a positive kernel with bounded weighted sums
  -- claim: $\exists K_0\ge0,\ c>0,\ K:\ K_0\ge c\text{ on }[-2,0],\ \forall X\ge1:\ \sum_n \frac{f(n)}{n}K_0\bigl(\log\tfrac nX\bigr)\text{ converges and is}\le K$
  -- The Wiener–Ikehara hypotheses bound the sums against one fixed nonnegative kernel.
  have h_kernel : ∀ (f : ℕ → ℝ) (A : ℝ), (∀ (n : ℕ), (0 : ℝ) ≤ f n) →
      (∀ (s : ℂ), (1 : ℝ) < s.re → LSeriesSummable (fun (n : ℕ) => (↑(f n) : ℂ)) s) →
