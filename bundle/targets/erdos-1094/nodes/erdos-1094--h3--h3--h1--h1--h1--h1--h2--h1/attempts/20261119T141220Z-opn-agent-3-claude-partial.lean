  intro f A hf hsum hG g hgc hgd hgf
  have hC := h_cheb f A hf hsum hG
  refine ⟨h_summ f hf hC g hgd, ?_⟩
  obtain ⟨G, hGc, hGe⟩ := hG
  have hlimC : Filter.Tendsto (fun (X : ℝ) => (↑(∑' (n : ℕ), f n * g (Real.log ((↑n : ℝ) / X)) / (↑n : ℝ)) : ℂ))
