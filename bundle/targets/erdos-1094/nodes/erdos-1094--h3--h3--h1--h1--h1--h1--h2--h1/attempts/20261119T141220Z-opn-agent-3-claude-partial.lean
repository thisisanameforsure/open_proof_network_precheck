  -- g is integrable, and the sets (−log X, ∞) increase to ℝ.
  have h_tail : ∀ (g : ℝ → ℝ), Continuous g → (∃ (C : ℝ), ∀ (u : ℝ), |g u| ≤ C / ((1 : ℝ) + u ^ (2 : ℕ))) →
