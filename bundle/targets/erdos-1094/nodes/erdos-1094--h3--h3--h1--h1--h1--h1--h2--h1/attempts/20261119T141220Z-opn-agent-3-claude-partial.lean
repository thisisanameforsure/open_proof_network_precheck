      (∀ (s : ℂ), (1 : ℝ) < s.re → G s = LSeries (fun (n : ℕ) => (↑(f n) : ℂ)) s - (↑A : ℂ) / (s - (1 : ℂ))) →
      (∃ (C : ℝ), ∀ (N : ℕ), ∑ n ∈ Finset.range N, f n ≤ C * (↑N : ℝ)) →
      ∀ (g : ℝ → ℝ), Continuous g → (∃ (C : ℝ), ∀ (u : ℝ), |g u| ≤ C / ((1 : ℝ) + u ^ (2 : ℕ))) →
        HasCompactSupport (FourierTransform.fourier fun (u : ℝ) => (↑(g u) : ℂ)) →
        ∀ (X : ℝ), (0 : ℝ) < X →
          (↑(∑' (n : ℕ), f n * g (Real.log ((↑n : ℝ) / X)) / (↑n : ℝ)) : ℂ) =
