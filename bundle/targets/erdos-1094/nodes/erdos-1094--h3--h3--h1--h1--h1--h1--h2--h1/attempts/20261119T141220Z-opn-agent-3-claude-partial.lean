                Complex.exp (-(2 * ↑Real.pi * Complex.I * ↑(Real.log X) * ↑ξ)) *
                G (1 - 2 * ↑Real.pi * Complex.I * ↑ξ)) +
              (↑A : ℂ) * ↑(∫ (v : ℝ) in Set.Ioi (-Real.log X), g v) := by
    sorry
  -- label: Riemann–Lebesgue along log X
  -- claim: $\int_{\mathbb R}\hat g(\xi)\,e^{-2\pi i\xi\log X}\,G(1-2\pi i\xi)\,d\xi\to0 \text{ as } X\to\infty$
  -- The Riemann–Lebesgue lemma for ξ ↦ ĝ(ξ) G(1 − 2πiξ), evaluated at log X → ∞.
  have h_rl : ∀ (G : ℂ → ℂ) (g : ℝ → ℝ),
      Filter.Tendsto (fun (X : ℝ) => ∫ (ξ : ℝ), FourierTransform.fourier (fun (u : ℝ) => (↑(g u) : ℂ)) ξ *
