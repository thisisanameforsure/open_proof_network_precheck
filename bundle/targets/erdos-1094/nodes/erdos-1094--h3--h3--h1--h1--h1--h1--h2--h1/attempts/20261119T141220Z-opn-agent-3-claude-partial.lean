  -- approach: PNT+'s route (limiting_fourier, limiting_cor): an a priori bound S(N) = O(N); with it the weighted sums converge (dyadic blocks); Fourier inversion and Re s → 1+ give Σ = ∫ ĝ(ξ) e^{-2πiξ log X} G(1−2πiξ) dξ + A ∫_{−log X}^∞ g; Riemann–Lebesgue and ∫_{−y}^∞ g → ∫ g.
  -- licence: CC-BY-4.0
  -- label: Chebyshev bound under the Wiener–Ikehara hypotheses
  -- claim: $f\ge0,\ F(s)-\frac{A}{s-1}\text{ continuous on }\Re s\ge1 \Rightarrow \exists C\ \forall N:\ \sum_{n<N} f(n)\le C N$
  -- The partial sums of f grow at most linearly.
  have h_cheb : ∀ (f : ℕ → ℝ) (A : ℝ), (∀ (n : ℕ), (0 : ℝ) ≤ f n) →
      (∀ (s : ℂ), (1 : ℝ) < s.re → LSeriesSummable (fun (n : ℕ) => (↑(f n) : ℂ)) s) →
      (∃ (G : ℂ → ℂ), ContinuousOn G {s : ℂ | (1 : ℝ) ≤ s.re} ∧
          ∀ (s : ℂ), (1 : ℝ) < s.re → G s = LSeries (fun (n : ℕ) => (↑(f n) : ℂ)) s - (↑A : ℂ) / (s - (1 : ℂ))) →
      ∃ (C : ℝ), ∀ (N : ℕ), ∑ n ∈ Finset.range N, f n ≤ C * (↑N : ℝ) := by
    sorry
  -- label: weighted sums converge under a Chebyshev bound
  -- claim: $f\ge0,\ \sum_{n<N} f(n)\le CN,\ |g(u)|\le\frac{D}{1+u^2},\ X>0 \Rightarrow \sum_n \frac{f(n)}{n}\,g\bigl(\log\tfrac nX\bigr)\text{ converges absolutely}$
  -- Compare with f(n)/(n(1+log² n)) and sum over dyadic blocks [2^j, 2^(j+1)).
  have h_summ : ∀ (f : ℕ → ℝ), (∀ (n : ℕ), (0 : ℝ) ≤ f n) →
      (∃ (C : ℝ), ∀ (N : ℕ), ∑ n ∈ Finset.range N, f n ≤ C * (↑N : ℝ)) →
      ∀ (g : ℝ → ℝ), (∃ (C : ℝ), ∀ (u : ℝ), |g u| ≤ C / ((1 : ℝ) + u ^ (2 : ℕ))) →
