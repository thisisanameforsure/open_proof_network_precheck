theorem erdos_1094__h3__h3__h1__h1__h1__h1__h2__h1 : ∀ (f : ℕ → ℝ) (A : ℝ),
  (∀ (n : ℕ), (0 : ℝ) ≤ f n) →
    (∀ (s : ℂ), (1 : ℝ) < s.re → LSeriesSummable (fun (n : ℕ) => (↑(f n) : ℂ)) s) →
