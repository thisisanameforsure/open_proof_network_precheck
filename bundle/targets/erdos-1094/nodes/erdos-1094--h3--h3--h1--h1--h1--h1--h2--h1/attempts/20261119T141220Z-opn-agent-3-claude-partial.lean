    sorry
  -- label: the limiting Fourier identity
  -- claim: $\sum_n \frac{f(n)}{n}\,g\bigl(\log\tfrac nX\bigr)=\int_{\mathbb R}\hat g(\xi)\,e^{-2\pi i\xi\log X}\,G(1-2\pi i\xi)\,d\xi+A\int_{-\log X}^{\infty} g(v)\,dv$
  -- For Re s = σ > 1 Fourier inversion and Fubini give Σ f(n) n^{-σ} g(log n − log X) = ∫ ĝ(ξ) e^{-2πiξ log X} F(σ − 2πiξ) dξ;
  -- split F = G + A/(s−1), write 1/(σ−1−2πiξ) = ∫_0^∞ e^{−(σ−1−2πiξ)t} dt, and let σ → 1+.
  have h_id : ∀ (f : ℕ → ℝ) (A : ℝ) (G : ℂ → ℂ), (∀ (n : ℕ), (0 : ℝ) ≤ f n) →
      (∀ (s : ℂ), (1 : ℝ) < s.re → LSeriesSummable (fun (n : ℕ) => (↑(f n) : ℂ)) s) →
