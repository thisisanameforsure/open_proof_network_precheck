-- hole: h_summ

private theorem ws_weight (a y : ℝ) : 1 / (1 + (a - y) ^ 2) ≤ 2 * (1 + 2 * y ^ 2) / (1 + a ^ 2) := by
  have h1 : 0 < 1 + (a - y) ^ 2 := by positivity
  have h2 : 0 < 1 + a ^ 2 := by positivity
  rw [div_le_div_iff₀ h1 h2]
  nlinarith [sq_nonneg (a - 2 * y), sq_nonneg y, sq_nonneg (a - y), mul_nonneg (sq_nonneg y) (sq_nonneg (a - y))]

private theorem ws_block (f : ℕ → ℝ) (hf : ∀ n, 0 ≤ f n) (C : ℝ)
    (hC : ∀ N : ℕ, ∑ n ∈ Finset.range N, f n ≤ C * N) (j : ℕ) :
    ∑ n ∈ Finset.Ico (2 ^ j) (2 ^ (j + 1)), f n / ((n : ℝ) * (1 + Real.log n ^ 2)) ≤
      2 * C / (1 + ((j : ℝ) * Real.log 2) ^ 2) := by
  have hpos : (0 : ℝ) < 2 ^ j := by positivity
  have hD : (0 : ℝ) < (2 : ℝ) ^ j * (1 + ((j : ℝ) * Real.log 2) ^ 2) := by positivity
  have hterm : ∀ n ∈ Finset.Ico (2 ^ j) (2 ^ (j + 1)),
      f n / ((n : ℝ) * (1 + Real.log n ^ 2)) ≤ f n / ((2 : ℝ) ^ j * (1 + ((j : ℝ) * Real.log 2) ^ 2)) := by
    intro n hn
    rw [Finset.mem_Ico] at hn
    have hn1 : ((2 : ℝ) ^ j) ≤ (n : ℝ) := by exact_mod_cast hn.1
    have hlog : (j : ℝ) * Real.log 2 ≤ Real.log n := by
      rw [← Real.log_pow]
      exact Real.log_le_log hpos hn1
    have hl0 : 0 ≤ (j : ℝ) * Real.log 2 := mul_nonneg (Nat.cast_nonneg j) (Real.log_nonneg (by norm_num))
    have hsq : ((j : ℝ) * Real.log 2) ^ 2 ≤ Real.log n ^ 2 := pow_le_pow_left₀ hl0 hlog 2
    apply div_le_div_of_nonneg_left (hf n) hD
    exact mul_le_mul hn1 (by linarith) (by positivity) (by linarith)
  calc ∑ n ∈ Finset.Ico (2 ^ j) (2 ^ (j + 1)), f n / ((n : ℝ) * (1 + Real.log n ^ 2))
      ≤ ∑ n ∈ Finset.Ico (2 ^ j) (2 ^ (j + 1)), f n / ((2 : ℝ) ^ j * (1 + ((j : ℝ) * Real.log 2) ^ 2)) :=
        Finset.sum_le_sum hterm
    _ = (∑ n ∈ Finset.Ico (2 ^ j) (2 ^ (j + 1)), f n) / ((2 : ℝ) ^ j * (1 + ((j : ℝ) * Real.log 2) ^ 2)) := by
        rw [Finset.sum_div]
    _ ≤ (C * (2 : ℝ) ^ (j + 1)) / ((2 : ℝ) ^ j * (1 + ((j : ℝ) * Real.log 2) ^ 2)) := by
        apply div_le_div_of_nonneg_right _ hD.le
        have h1 : ∑ n ∈ Finset.Ico (2 ^ j) (2 ^ (j + 1)), f n ≤ ∑ n ∈ Finset.range (2 ^ (j + 1)), f n :=
          Finset.sum_le_sum_of_subset_of_nonneg
            (fun x hx => by rw [Finset.mem_Ico] at hx; rw [Finset.mem_range]; exact hx.2)
            (fun i _ _ => hf i)
        have h2 := hC (2 ^ (j + 1))
        push_cast at h2
        linarith
    _ = 2 * C / (1 + ((j : ℝ) * Real.log 2) ^ 2) := by
        rw [pow_succ]
        field_simp

private theorem ws_dyadic (t : ℕ → ℝ) (J : ℕ) :
    ∑ n ∈ Finset.range (2 ^ J), t n = t 0 + ∑ j ∈ Finset.range J, ∑ n ∈ Finset.Ico (2 ^ j) (2 ^ (j + 1)), t n := by
  induction J with
  | zero => simp
  | succ J ih =>
    rw [Finset.sum_range_succ, ← add_assoc, ← ih]
    exact (Finset.sum_range_add_sum_Ico t (Nat.pow_le_pow_right (by norm_num) (Nat.le_succ J))).symm

private theorem ws_summable_base (f : ℕ → ℝ) (hf : ∀ n, 0 ≤ f n) (C : ℝ)
    (hC : ∀ N : ℕ, ∑ n ∈ Finset.range N, f n ≤ C * N) :
    Summable (fun n : ℕ => f n / ((n : ℝ) * (1 + Real.log n ^ 2))) := by
  have hnn : ∀ n : ℕ, 0 ≤ f n / ((n : ℝ) * (1 + Real.log n ^ 2)) := fun n =>
    div_nonneg (hf n) (by positivity)
  have hC0 : 0 ≤ C := by
    have := hC 1
    simp at this
    linarith [hf 0]
  have hs : Summable (fun j : ℕ => (8 * C) / (1 + (j : ℝ) ^ 2)) := by
    have : Summable (fun j : ℕ => 1 / (1 + (j : ℝ) ^ 2)) := by
      apply Summable.of_nonneg_of_le (fun j => by positivity)
        (fun j => ?_) (Real.summable_one_div_nat_pow.mpr (by norm_num : 1 < 2) |>.add
          (summable_of_ne_finset_zero (s := {0}) (f := fun j : ℕ => if j = 0 then (1 : ℝ) else 0)
            (fun j hj => by simp at hj; simp [hj])))
      rcases Nat.eq_zero_or_pos j with h0 | hpos
      · subst h0; simp
      · have hj : (1 : ℝ) ≤ j := by exact_mod_cast hpos
        have : 1 / (1 + (j : ℝ) ^ 2) ≤ 1 / (j : ℝ) ^ 2 :=
          one_div_le_one_div_of_le (by positivity) (by linarith)
        simp [Nat.pos_iff_ne_zero.mp hpos]
        simpa using this
    exact (this.mul_left (8 * C)).congr (fun j => by rw [mul_one_div])
  have hlog2 : (1 / 2 : ℝ) ≤ Real.log 2 := by
    have := Real.log_two_gt_d9
    linarith
  have hblock : ∀ j : ℕ, ∑ n ∈ Finset.Ico (2 ^ j) (2 ^ (j + 1)), f n / ((n : ℝ) * (1 + Real.log n ^ 2)) ≤
      (8 * C) / (1 + (j : ℝ) ^ 2) := by
    intro j
    refine (ws_block f hf C hC j).trans ?_
    have hjl : (j : ℝ) / 2 ≤ (j : ℝ) * Real.log 2 := by nlinarith [Nat.cast_nonneg (α := ℝ) j]
    have hsq : ((j : ℝ) / 2) ^ 2 ≤ ((j : ℝ) * Real.log 2) ^ 2 :=
      pow_le_pow_left₀ (by positivity) hjl 2
    rw [div_le_div_iff₀ (by positivity) (by positivity)]
    nlinarith [sq_nonneg (j : ℝ)]
  apply summable_of_sum_range_le hnn (c := ∑' j : ℕ, (8 * C) / (1 + (j : ℝ) ^ 2))
  intro N
  have hN : N ≤ 2 ^ N := Nat.lt_two_pow_self.le
  calc ∑ n ∈ Finset.range N, f n / ((n : ℝ) * (1 + Real.log n ^ 2))
      ≤ ∑ n ∈ Finset.range (2 ^ N), f n / ((n : ℝ) * (1 + Real.log n ^ 2)) :=
        Finset.sum_le_sum_of_subset_of_nonneg (Finset.range_mono hN) (fun i _ _ => hnn i)
    _ = ∑ j ∈ Finset.range N, ∑ n ∈ Finset.Ico (2 ^ j) (2 ^ (j + 1)), f n / ((n : ℝ) * (1 + Real.log n ^ 2)) := by
        rw [ws_dyadic]; simp
    _ ≤ ∑ j ∈ Finset.range N, (8 * C) / (1 + (j : ℝ) ^ 2) := Finset.sum_le_sum (fun j _ => hblock j)
    _ ≤ ∑' j : ℕ, (8 * C) / (1 + (j : ℝ) ^ 2) :=
        hs.sum_le_tsum _ (fun j _ => by positivity)

private theorem ws_summable (f : ℕ → ℝ) (hf : ∀ n, 0 ≤ f n)
    (hcheb : ∃ (C : ℝ), ∀ (N : ℕ), ∑ n ∈ Finset.range N, f n ≤ C * (N : ℝ))
    (g : ℝ → ℝ) (hg : ∃ (C : ℝ), ∀ (u : ℝ), |g u| ≤ C / ((1 : ℝ) + u ^ (2 : ℕ)))
    (X : ℝ) (hX : 0 < X) :
    Summable (fun (n : ℕ) => f n * g (Real.log ((↑n : ℝ) / X)) / (↑n : ℝ)) := by
  obtain ⟨C, hC⟩ := hcheb
  obtain ⟨D, hD⟩ := hg
  have hD0 : 0 ≤ D := by
    have := hD 0
    simp at this
    linarith [abs_nonneg (g 0)]
  set y := Real.log X
  set K := D * (2 * (1 + 2 * y ^ 2)) with hK
  have hK0 : 0 ≤ K := by positivity
  refine Summable.of_norm_bounded ((ws_summable_base f hf C hC).mul_left K) (fun n => ?_)
  rcases Nat.eq_zero_or_pos n with h0 | hpos
  · subst h0; simp
  · have hn : (0 : ℝ) < (n : ℝ) := by exact_mod_cast hpos
    have hlog : Real.log ((n : ℝ) / X) = Real.log n - y := Real.log_div hn.ne' hX.ne'
    rw [hlog, Real.norm_eq_abs, abs_div, abs_mul, abs_of_nonneg (hf n), abs_of_pos hn]
    have hw := ws_weight (Real.log n) y
    have hg1 := hD (Real.log n - y)
    have h1 : |g (Real.log n - y)| ≤ D * (2 * (1 + 2 * y ^ 2) / (1 + Real.log n ^ 2)) := by
      calc |g (Real.log n - y)| ≤ D / (1 + (Real.log n - y) ^ 2) := hg1
        _ = D * (1 / (1 + (Real.log n - y) ^ 2)) := by ring
        _ ≤ D * (2 * (1 + 2 * y ^ 2) / (1 + Real.log n ^ 2)) := mul_le_mul_of_nonneg_left hw hD0
    have hL : 0 < 1 + Real.log n ^ 2 := by positivity
    calc f n * |g (Real.log n - y)| / (n : ℝ)
        ≤ f n * (D * (2 * (1 + 2 * y ^ 2) / (1 + Real.log n ^ 2))) / (n : ℝ) :=
          div_le_div_of_nonneg_right (mul_le_mul_of_nonneg_left h1 (hf n)) hn.le
      _ = K * (f n / ((n : ℝ) * (1 + Real.log n ^ 2))) := by
          rw [hK]; field_simp

-- proof:
by
  intro f hf hcheb g hg X hX
  exact ws_summable f hf hcheb g hg X hX
