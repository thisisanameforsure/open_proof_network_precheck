private lemma theta_diff_eq (k : ℕ) (X : ℝ) (hX : (k : ℝ) ≤ X) :
    Chebyshev.theta X - Chebyshev.theta (k : ℝ) =
      ∑ p ∈ (Finset.Ioc k ⌊X⌋₊).filter Nat.Prime, Real.log p := by
  have hkM : k ≤ ⌊X⌋₊ := Nat.le_floor hX
  unfold Chebyshev.theta
  rw [Nat.floor_natCast, Finset.sum_filter, Finset.sum_filter, Finset.sum_filter,
    ← Finset.sum_Ioc_consecutive _ (Nat.zero_le k) hkM]
  ring

private lemma count_bound (k : ℕ) (X : ℝ) (hX : (k : ℝ) ≤ X) (hX1 : 1 ≤ X) :
    Chebyshev.theta X - Chebyshev.theta (k : ℝ) ≤
      ((((Finset.Ioo ⌊(k : ℝ)⌋ ⌈X⌉).filter (fun p : ℤ => (0 : ℤ) < p ∧ Nat.Prime p.natAbs ∧
        (k : ℝ) < (p : ℝ) ∧ (p : ℝ) < X)).card : ℝ) + 1) * Real.log X := by
  rw [theta_diff_eq k X hX]
  set A := (Finset.Ioc k ⌊X⌋₊).filter Nat.Prime with hA
  set S := (Finset.Ioo ⌊(k : ℝ)⌋ ⌈X⌉).filter (fun p : ℤ => (0 : ℤ) < p ∧ Nat.Prime p.natAbs ∧
        (k : ℝ) < (p : ℝ) ∧ (p : ℝ) < X) with hS
  have hlogX : 0 ≤ Real.log X := Real.log_nonneg hX1
  have h1 : ∑ p ∈ A, Real.log p ≤ (A.card : ℝ) * Real.log X := by
    have : ∑ p ∈ A, Real.log p ≤ ∑ p ∈ A, Real.log X := by
      apply Finset.sum_le_sum
      intro p hp
      rw [hA, Finset.mem_filter, Finset.mem_Ioc] at hp
      have hp0 : (0 : ℝ) < p := by exact_mod_cast hp.2.pos
      apply Real.log_le_log hp0
      have : (p : ℝ) ≤ (⌊X⌋₊ : ℝ) := by exact_mod_cast hp.1.2
      exact this.trans (Nat.floor_le (by linarith))
    simpa using this
  have h2 : A.card ≤ S.card + 1 := by
    have hsplit := Finset.card_filter_add_card_filter_not (s := A) (fun p : ℕ => (p : ℝ) < X)
    have hb : (A.filter (fun p : ℕ => ¬ (p : ℝ) < X)).card ≤ 1 := by
      apply Finset.card_le_one.mpr
      intro a ha b hb
      rw [Finset.mem_filter, hA, Finset.mem_filter, Finset.mem_Ioc] at ha hb
      have hfa : ((⌊X⌋₊ : ℕ) : ℝ) ≤ X := Nat.floor_le (by linarith)
      have ha' : (a : ℝ) ≤ (⌊X⌋₊ : ℝ) := by exact_mod_cast ha.1.1.2
      have hb' : (b : ℝ) ≤ (⌊X⌋₊ : ℝ) := by exact_mod_cast hb.1.1.2
      have e : (a : ℝ) = b := by push Not at ha hb; linarith [ha.2, hb.2]
      exact_mod_cast e
    have ha : (A.filter (fun p : ℕ => (p : ℝ) < X)).card ≤ S.card := by
      rw [← Finset.card_map ⟨(Nat.cast : ℕ → ℤ), Nat.cast_injective⟩]
      apply Finset.card_le_card
      intro z hz
      rw [Finset.mem_map] at hz
      obtain ⟨p, hp, rfl⟩ := hz
      rw [Finset.mem_filter, hA, Finset.mem_filter, Finset.mem_Ioc] at hp
      obtain ⟨⟨⟨hkp, _⟩, hpp⟩, hpX⟩ := hp
      rw [hS, Finset.mem_filter, Finset.mem_Ioo]
      simp only [Function.Embedding.coeFn_mk, Int.floor_natCast, Int.cast_natCast, Int.natAbs_natCast]
      refine ⟨⟨by exact_mod_cast hkp, Int.lt_ceil.mpr (by exact_mod_cast hpX)⟩, by exact_mod_cast hpp.pos, hpp,
        by exact_mod_cast hkp, hpX⟩
    omega
  calc ∑ p ∈ A, Real.log p ≤ (A.card : ℝ) * Real.log X := h1
    _ ≤ ((S.card : ℝ) + 1) * Real.log X := by
      apply mul_le_mul_of_nonneg_right _ hlogX
      exact_mod_cast h2

private lemma psi_theta_diff (k : ℕ) (X : ℝ) (hk : 1 ≤ k) (hX : (k : ℝ) ≤ X) :
    Chebyshev.psi X - Chebyshev.psi (k : ℝ) - 4 * Real.sqrt X * Real.log X ≤
      Chebyshev.theta X - Chebyshev.theta (k : ℝ) := by
  have hk1 : (1 : ℝ) ≤ k := by exact_mod_cast hk
  have hX1 : (1 : ℝ) ≤ X := hk1.trans hX
  have a1 := Chebyshev.abs_psi_sub_theta_le_sqrt_mul_log hX1
  have a2 := Chebyshev.abs_psi_sub_theta_le_sqrt_mul_log hk1
  have hs : Real.sqrt k ≤ Real.sqrt X := Real.sqrt_le_sqrt hX
  have hl : Real.log k ≤ Real.log X := Real.log_le_log (by linarith) hX
  have hl0 : 0 ≤ Real.log k := Real.log_nonneg hk1
  have hm : Real.sqrt k * Real.log k ≤ Real.sqrt X * Real.log X :=
    mul_le_mul hs hl hl0 (Real.sqrt_nonneg _)
  have := abs_le.mp a1
  have := abs_le.mp a2
  nlinarith

private lemma log_small (ε : ℝ) (hε : 0 < ε) :
    ∃ K : ℕ, ∀ k : ℕ, K ≤ k → Real.log k ≤ ε * (k : ℝ) ^ (1 / 40 : ℝ) := by
  have h := (isLittleO_log_rpow_atTop (r := (1 / 40 : ℝ)) (by norm_num)).def hε
  have h2 := (tendsto_natCast_atTop_atTop (R := ℝ)).eventually h
  obtain ⟨K, hK⟩ := Filter.eventually_atTop.mp (h2.and (Filter.eventually_ge_atTop 1))
  refine ⟨K, fun k hk => ?_⟩
  obtain ⟨a, b⟩ := hK k hk
  have hk1 : (1 : ℝ) ≤ k := by exact_mod_cast b
  rw [Real.norm_eq_abs, Real.norm_eq_abs, abs_of_nonneg (Real.log_nonneg hk1),
    abs_of_nonneg (Real.rpow_nonneg (by linarith) _)] at a
  exact a

private lemma bhp_from_psi (c : ℝ) (hc : 0 < c) (k₀ : ℕ)
    (hψ : ∀ k : ℕ, k₀ ≤ k → c * (k : ℝ) ^ (21 / 40 : ℝ) ≤
      Chebyshev.psi ((k : ℝ) + (k : ℝ) ^ (21 / 40 : ℝ)) - Chebyshev.psi (k : ℝ)) :
    ∃ (C : ℝ),
      (0 : ℝ) < C ∧
        ∃ (k₀ : ℕ),
          ∀ (k : ℕ),
            k₀ ≤ k →
              C * (↑k : ℝ) ^ (21 / 40 : ℝ) / Real.log (↑k : ℝ) ≤
                (↑{p ∈ Finset.Ioo ⌊(↑k : ℝ)⌋ ⌈(↑k : ℝ) + (↑k : ℝ) ^ (21 / 40 : ℝ)⌉ |
                        (0 : ℤ) < p ∧
                          Nat.Prime p.natAbs ∧ (↑k : ℝ) < (↑p : ℝ) ∧ (↑p : ℝ) < (↑k : ℝ) + (↑k : ℝ) ^ (21 / 40 : ℝ)}.card :
                  ℝ) := by
  obtain ⟨K, hK⟩ := log_small (c / 72) (by positivity)
  refine ⟨c / 4, by positivity, max (max k₀ K) 3, ?_⟩
  intro k hk
  have hk0 : k₀ ≤ k := le_trans (le_trans (le_max_left _ _) (le_max_left _ _)) hk
  have hkK : K ≤ k := le_trans (le_trans (le_max_right _ _) (le_max_left _ _)) hk
  have hk3 : 3 ≤ k := le_trans (le_max_right _ _) hk
  have hkR : (3 : ℝ) ≤ k := by exact_mod_cast hk3
  have hkpos : (0 : ℝ) < k := by linarith
  set y := (k : ℝ) ^ (21 / 40 : ℝ) with hy
  set X := (k : ℝ) + y with hXdef
  have hy0 : 0 < y := Real.rpow_pos_of_pos hkpos _
  have hyk : y ≤ k := by
    have := Real.rpow_le_rpow_of_exponent_le (by linarith : (1 : ℝ) ≤ k) (show (21 / 40 : ℝ) ≤ 1 by norm_num)
    rwa [Real.rpow_one] at this
  have hkX : (k : ℝ) ≤ X := by linarith
  have hX1 : (1 : ℝ) ≤ X := by linarith
  have hL : 0 < Real.log k := Real.log_pos (by linarith)
  have hLX : 0 < Real.log X := Real.log_pos (by linarith)
  have hLX2 : Real.log X ≤ 2 * Real.log k := by
    have : X ≤ (k : ℝ) ^ 2 := by nlinarith
    calc Real.log X ≤ Real.log ((k : ℝ) ^ 2) := Real.log_le_log (by linarith) this
      _ = 2 * Real.log k := by rw [Real.log_pow]; ring
  have hcnt := count_bound k X hkX hX1
  have hpt := psi_theta_diff k X (by omega) hkX
  have hps := hψ k hk0
  set S := (((Finset.Ioo ⌊(k : ℝ)⌋ ⌈X⌉).filter (fun p : ℤ => (0 : ℤ) < p ∧ Nat.Prime p.natAbs ∧
        (k : ℝ) < (p : ℝ) ∧ (p : ℝ) < X)).card : ℝ) with hSdef
  have hS0 : 0 ≤ S := by positivity
  have hsq : Real.sqrt X ≤ 2 * Real.sqrt k := by
    have h4 : Real.sqrt X ≤ Real.sqrt (4 * k) := Real.sqrt_le_sqrt (by linarith)
    rw [Real.sqrt_mul (by norm_num), show Real.sqrt 4 = 2 by
      rw [show (4 : ℝ) = 2 ^ 2 by norm_num, Real.sqrt_sq (by norm_num)]] at h4
    exact h4
  have hsk1 : 1 ≤ Real.sqrt k := by rw [Real.one_le_sqrt]; linarith
  have hsqrt_rpow : Real.sqrt k * (k : ℝ) ^ (1 / 40 : ℝ) = y := by
    rw [Real.sqrt_eq_rpow, ← Real.rpow_add hkpos]; norm_num [hy]
  have hasym : 36 * Real.sqrt k * Real.log k ≤ c / 2 * y := by
    have h := hK k hkK
    have hs0 : 0 ≤ Real.sqrt k := Real.sqrt_nonneg _
    calc 36 * Real.sqrt k * Real.log k ≤ 36 * Real.sqrt k * (c / 72 * (k : ℝ) ^ (1 / 40 : ℝ)) :=
          mul_le_mul_of_nonneg_left h (by positivity)
      _ = c / 2 * (Real.sqrt k * (k : ℝ) ^ (1 / 40 : ℝ)) := by ring
      _ = c / 2 * y := by rw [hsqrt_rpow]
  have e1 : c * y ≤ (S + 1 + 4 * Real.sqrt X) * Real.log X := by nlinarith
  have hpos : 0 ≤ S + 1 + 4 * Real.sqrt X := by positivity
  have e2 : (S + 1 + 4 * Real.sqrt X) * Real.log X ≤ (S + 1 + 4 * Real.sqrt X) * (2 * Real.log k) :=
    mul_le_mul_of_nonneg_left hLX2 hpos
  have e3 : (1 + 4 * Real.sqrt X) * Real.log k ≤ 9 * Real.sqrt k * Real.log k := by
    apply mul_le_mul_of_nonneg_right _ hL.le; linarith
  have key : 3 / 8 * (c * y) ≤ S * Real.log k := by nlinarith
  rw [div_le_iff₀ hL]
  nlinarith

theorem erdos_1094__h2__h2__h1 : ∃ (C : ℝ),
  (0 : ℝ) < C ∧
    ∃ (k₀ : ℕ),
      ∀ (k : ℕ),
        k₀ ≤ k →
          C * (↑k : ℝ) ^ (21 / 40 : ℝ) / Real.log (↑k : ℝ) ≤
            (↑{p ∈ Finset.Ioo ⌊(↑k : ℝ)⌋ ⌈(↑k : ℝ) + (↑k : ℝ) ^ (21 / 40 : ℝ)⌉ |
                    (0 : ℤ) < p ∧
                      Nat.Prime p.natAbs ∧ (↑k : ℝ) < (↑p : ℝ) ∧ (↑p : ℝ) < (↑k : ℝ) + (↑k : ℝ) ^ (21 / 40 : ℝ)}.card :
              ℝ) := by
  -- approach: since 21/40 > 1/2, prime powers are negligible: the Chebyshev-ψ form ψ(k+k^{21/40}) − ψ(k) ≫ k^{21/40} gives the same for θ up to 4√x log x (Mathlib), and θ's increment is at most (count + 1)·log(k+k^{21/40}), which yields the prime count ≫ k^{21/40}/log k
  -- licence: CC-BY-4.0
  -- label: BHP in Chebyshev ψ form
  -- claim: $\exists c>0\ \exists k_0\ \forall k\ge k_0:\ c\,k^{21/40}\le\psi\bigl(k+k^{21/40}\bigr)-\psi(k)$
  -- Here ψ is Mathlib's Chebyshev function, the sum of the von Mangoldt function over n ≤ x.
  have h_psi : ∃ (c : ℝ), (0 : ℝ) < c ∧ ∃ (k₀ : ℕ), ∀ (k : ℕ), k₀ ≤ k →
      c * (k : ℝ) ^ (21 / 40 : ℝ) ≤
        Chebyshev.psi ((k : ℝ) + (k : ℝ) ^ (21 / 40 : ℝ)) - Chebyshev.psi (k : ℝ) := sorry
  obtain ⟨c, hc, k₀, hψ⟩ := h_psi
  exact bhp_from_psi c hc k₀ hψ
