private lemma bump_exists (c r R : ℝ) (hr : 0 < r) (hR : r < R) :
    ∃ ψ : ℝ → ℝ, ContDiff ℝ (2 : WithTop ℕ∞) ψ ∧ HasCompactSupport ψ ∧
      Function.support ψ ⊆ Set.Ioo (c - R) (c + R) ∧ (∀ x, 0 ≤ ψ x) ∧ (∀ x, ψ x ≤ 1) ∧
      (∀ x, c - r ≤ x → x ≤ c + r → ψ x = 1) ∧
      2 * r ≤ ∫ x, ψ x ∧ ∫ x, ψ x ≤ 2 * R := by
  let b : ContDiffBump c := ⟨r, R, hr, hR⟩
  have hsupp : Function.support b ⊆ Set.Ioo (c - R) (c + R) := by
    rw [b.support_eq, Real.ball_eq_Ioo]
  have hint : MeasureTheory.Integrable (fun x => b x) := b.continuous.integrable_of_hasCompactSupport b.hasCompactSupport
  refine ⟨b, b.contDiff, b.hasCompactSupport, hsupp, fun x => b.nonneg, fun x => b.le_one, ?_, ?_, ?_⟩
  · intro x h1 h2
    apply b.one_of_mem_closedBall
    rw [Real.closedBall_eq_Icc]; exact ⟨h1, h2⟩
  · have hle : Set.indicator (Set.Icc (c - r) (c + r)) (fun _ => (1:ℝ)) ≤ fun x => b x := by
      intro x
      by_cases hx : x ∈ Set.Icc (c - r) (c + r)
      · rw [Set.indicator_of_mem hx]
        exact le_of_eq (b.one_of_mem_closedBall (by rw [Real.closedBall_eq_Icc]; exact hx)).symm
      · rw [Set.indicator_of_notMem hx]; exact b.nonneg
    have hi : MeasureTheory.Integrable (Set.indicator (Set.Icc (c - r) (c + r)) (fun _ => (1:ℝ))) :=
      (continuous_const.integrableOn_Icc).integrable_indicator measurableSet_Icc
    have := MeasureTheory.integral_mono hi hint hle
    rw [MeasureTheory.integral_indicator_const _ measurableSet_Icc] at this
    simp at this
    linarith
  · have hle : (fun x => b x) ≤ Set.indicator (Set.Ioo (c - R) (c + R)) (fun _ => (1:ℝ)) := by
      intro x
      by_cases hx : x ∈ Set.Ioo (c - R) (c + R)
      · rw [Set.indicator_of_mem hx]; exact b.le_one
      · rw [Set.indicator_of_notMem hx]
        by_contra h
        exact hx (hsupp (Function.mem_support.mpr (by intro h0; exact h (le_of_eq h0))))
    have hi : MeasureTheory.Integrable (Set.indicator (Set.Ioo (c - R) (c + R)) (fun _ => (1:ℝ))) :=
      ((continuous_const.integrableOn_Icc).mono_set Set.Ioo_subset_Icc_self).integrable_indicator measurableSet_Ioo
    have := MeasureTheory.integral_mono hint hi hle
    rw [MeasureTheory.integral_indicator_const _ measurableSet_Ioo] at this
    simp at this
    rcases this with h | h <;> linarith

private lemma lower_sum (f : ℕ → ℝ) (hf : ∀ n, 0 ≤ f n) (ψ : ℝ → ℝ)
    (h0 : ∀ x, 1 ≤ x → ψ x = 0) (h1 : ∀ x, ψ x ≤ 1) (N : ℕ) (hN : (0 : ℝ) < N) :
    ∑' n : ℕ, f n * ψ ((n : ℝ) / N) ≤ ∑ n ∈ Finset.range N, f n := by
  rw [tsum_eq_sum (s := Finset.range N)]
  · apply Finset.sum_le_sum
    intro n _
    exact mul_le_of_le_one_right (hf n) (h1 _)
  · intro n hn
    simp only [Finset.mem_range, not_lt] at hn
    rw [h0 _ ?_, mul_zero]
    rw [le_div_iff₀ hN, one_mul]
    exact_mod_cast hn

private lemma upper_sum (f : ℕ → ℝ) (hf : ∀ n, 0 ≤ f n) (ψ : ℝ → ℝ) (δ : ℝ)
    (h0 : ∀ x, 2 ≤ x → ψ x = 0) (hnn : ∀ x, 0 ≤ ψ x)
    (hone : ∀ x, δ ≤ x → x ≤ 1 → ψ x = 1) (N : ℕ) (hN : (0 : ℝ) < N)
    (hM : ⌈δ * N⌉₊ ≤ N) :
    ∑ n ∈ Finset.range N, f n ≤
      ∑ n ∈ Finset.range ⌈δ * N⌉₊, f n + ∑' n : ℕ, f n * ψ ((n : ℝ) / N) := by
  rw [tsum_eq_sum (s := Finset.range (2 * N))]
  · rw [← Finset.sum_range_add_sum_Ico _ hM]
    apply add_le_add le_rfl
    calc ∑ n ∈ Finset.Ico ⌈δ * N⌉₊ N, f n
        = ∑ n ∈ Finset.Ico ⌈δ * N⌉₊ N, f n * ψ ((n : ℝ) / N) := by
          apply Finset.sum_congr rfl
          intro n hn
          rw [Finset.mem_Ico] at hn
          rw [hone, mul_one]
          · rw [le_div_iff₀ hN]
            exact Nat.ceil_le.mp hn.1
          · rw [div_le_one hN]
            exact_mod_cast hn.2.le
      _ ≤ ∑ n ∈ Finset.range (2 * N), f n * ψ ((n : ℝ) / N) := by
          apply Finset.sum_le_sum_of_subset_of_nonneg
          · intro n hn
            rw [Finset.mem_Ico] at hn
            rw [Finset.mem_range]
            omega
          · intro n _ _
            exact mul_nonneg (hf n) (hnn _)
  · intro n hn
    simp only [Finset.mem_range, not_lt] at hn
    rw [h0 _ ?_, mul_zero]
    rw [le_div_iff₀ hN]
    exact_mod_cast hn

