/-! Hole `h_close` of a merged partial proof, as a node (D-12 #5, D-29).
Statement generated by the gate from the assembly; immutable (D-3). -/

private lemma e1094p_sep {a b m : ℕ} (hm : 0 < m) (hab : a ≤ b) (h : a / m = b / m) : b - a < m := by
  have h1 := Nat.lt_mul_div_succ b hm
  have h2 := Nat.div_mul_le_self a m
  rw [← h] at h1
  have : m * (a / m + 1) = a / m * m + m := by ring
  omega

private lemma e1094p_card {S : Finset ℕ} {k M g : ℕ}
    (hS : ∀ p ∈ S, k < 2 * p ∧ 2 * p - k ≤ M)
    (hsep : ∀ p ∈ S, ∀ q ∈ S, p < q → g < q - p) :
    (S.card - 1) * (2 * g + 1) ≤ M - 1 := by
  set m := 2 * g + 1 with hm
  have hm0 : 0 < m := by omega
  have hmap : ∀ p ∈ S, (2 * p - k - 1) / m ∈ Finset.range ((M - 1) / m + 1) := by
    intro p hp
    obtain ⟨h1, h2⟩ := hS p hp
    have h3 : 2 * p - k - 1 ≤ M - 1 := by omega
    exact Finset.mem_range.mpr (Nat.lt_succ_of_le (Nat.div_le_div_right h3))
  have hinj : Set.InjOn (fun p => (2 * p - k - 1) / m) S := by
    intro p hp q hq hpq
    simp only at hpq
    by_contra hne
    rcases Nat.lt_or_gt_of_ne hne with h | h
    · have := e1094p_sep hm0 (by omega : 2 * p - k - 1 ≤ 2 * q - k - 1) hpq
      have := hsep p hp q hq h
      have := (hS p hp).1
      omega
    · have := e1094p_sep hm0 (by omega : 2 * q - k - 1 ≤ 2 * p - k - 1) hpq.symm
      have := hsep q hq p hp h
      have := (hS q hq).1
      omega
  have hc : S.card ≤ (M - 1) / m + 1 := by
    have := Finset.card_le_card_of_injOn _ hmap hinj
    rwa [Finset.card_range] at this
  have h3 : (S.card - 1) * m ≤ (M - 1) / m * m := Nat.mul_le_mul_right m (Nat.sub_le_iff_le_add.mpr hc)
  exact h3.trans (Nat.div_mul_le_self _ _)

theorem erdos_1094__h3__h2__h3__h1 : ∃ (c : ℕ) (K : ℕ),
  ∀ (k : ℕ),
    K < k →
      ∃ (p : ℕ) (q : ℕ),
        Nat.Prime p ∧
          Nat.Prime q ∧
            k < (2 : ℕ) * p ∧
              p < q ∧ (16 : ℕ) * ((2 : ℕ) * q - k) ^ (4 : ℕ) ≤ k ^ (3 : ℕ) ∧ q - p ≤ c * Nat.log (2 : ℕ) k := by
  -- approach: pigeonhole on a large set of primes in (k/2, k/2 + k^(3/4)/4]: if consecutive ones were all more than c·log₂ k apart, the set would not fit in the interval; the size of the set is Ingham's (1937) count of primes in short intervals
  -- licence: CC-BY-4.0
  -- label: many primes just above k/2
  -- claim: $\exists c, K\ \forall k > K\ \exists S \subseteq \{p \text{ prime} : k < 2p,\ 16(2p-k)^4 \le k^3\}:\ k^3 < 16\,\big((|S| - 1)(2c\lfloor\log_2 k\rfloor + 1)\big)^4$
  -- A finite set $S$ of primes $p$ with $k/2 < p$ and $2p - k \le k^{3/4}/2$ whose size satisfies $(|S|-1)(2c\lfloor \log_2 k \rfloor + 1) > k^{3/4}/2$, in natural numbers.
  have h_ingham : ∃ c K : ℕ, ∀ k : ℕ, K < k → ∃ S : Finset ℕ,
      (∀ p ∈ S, p.Prime ∧ k < 2 * p ∧ 16 * (2 * p - k) ^ 4 ≤ k ^ 3) ∧
        k ^ 3 < 16 * ((S.card - 1) * (2 * (c * Nat.log 2 k) + 1)) ^ 4 := sorry
  obtain ⟨c, K, hK⟩ := h_ingham
  refine ⟨c, K, ?_⟩
  intro k hk
  obtain ⟨S, hS, hcount⟩ := hK k hk
  set g := c * Nat.log 2 k with hg
  set M := Nat.findGreatest (fun m => 16 * m ^ 4 ≤ k ^ 3) k with hM
  have hMspec : 16 * M ^ 4 ≤ k ^ 3 :=
    Nat.findGreatest_spec (P := fun m => 16 * m ^ 4 ≤ k ^ 3) (Nat.zero_le _) (by simp)
  have hle : ∀ p ∈ S, k < 2 * p ∧ 2 * p - k ≤ M := by
    intro p hp
    obtain ⟨_, h1, h2⟩ := hS p hp
    refine ⟨h1, Nat.le_findGreatest ?_ h2⟩
    by_contra hc
    push_neg at hc
    have : k ^ 4 < (2 * p - k) ^ 4 := Nat.pow_lt_pow_left hc (by norm_num)
    have h5 : k ^ 3 ≤ k ^ 4 := Nat.pow_le_pow_right (by omega) (by norm_num)
    omega
  by_contra hno
  push_neg at hno
  have hsep : ∀ p ∈ S, ∀ q ∈ S, p < q → g < q - p := by
    intro p hp q hq hpq
    by_contra hc
    push_neg at hc
    obtain ⟨hpP, h1, _⟩ := hS p hp
    obtain ⟨hqP, _, h2⟩ := hS q hq
    exact absurd hc (by have := hno p q hpP hqP h1 hpq h2; omega)
  have hcard := e1094p_card hle hsep
  have h6 : (S.card - 1) * (2 * g + 1) ≤ M := le_trans hcard (Nat.sub_le _ _)
  have h7 : ((S.card - 1) * (2 * g + 1)) ^ 4 ≤ M ^ 4 := Nat.pow_le_pow_left h6 4
  omega

