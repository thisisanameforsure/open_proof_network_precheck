/-! Hole `hinf` of a merged partial proof, as a node (D-12 #5, D-29).
Statement generated by the gate from the assembly; immutable (D-3). -/

theorem spec_a70fcca4__h4__h2 : ∀ (r : ℕ → ℝ),
  r (0 : ℕ) = (1 / 2 : ℝ) →
    (∀ (m : ℕ),
        r (m + (1 : ℕ)) =
          if (1 : ℝ) / ((2 : ℝ) ^ m - (1 : ℝ)) ≤ r m then r m - (1 : ℝ) / ((2 : ℝ) ^ m - (1 : ℝ)) else r m) →
      ∀ (m : ℕ), ∃ (n : ℕ), m < n ∧ r n < (1 : ℝ) / ((2 : ℝ) ^ n - (1 : ℝ)) := by
  intro r h0 hstep
  -- approach: if the 1/2 walk takes every step past m, its remainder r_{m+1} (a rational) is a tail of the Erdős–Borwein series once the walk does not stall; Erdős 1948 makes every such tail irrational.
  -- licence: CC-BY-4.0
  -- Hole: Erdős (1948) — every tail of ∑ 1/(2^n - 1) is irrational.
  -- label: every tail of the Erdős–Borwein series is irrational
  -- claim: $\forall M,\ \sum_{k\ge 0} \frac{1}{2^{M+k}-1} \notin \mathbb{Q}$
  have h_tail_irr : ∀ M : ℕ, Irrational (∑' k : ℕ, (1 : ℝ) / ((2 : ℝ) ^ (M + k) - 1)) := by
    sorry
  -- Hole: the walk of 1/2 does not stall: if it takes every step past m, its remainder tends to 0.
  -- label: the greedy walk of 1/2 does not stall
  -- claim: $\forall m,\ (\forall n>m,\ \frac{1}{2^n-1}\le r_n) \Rightarrow r_n \to 0$, for the greedy remainder $r$ of $\frac12$
  have h_nostall : ∀ m : ℕ, (∀ n : ℕ, m < n → (1 : ℝ) / ((2 : ℝ) ^ n - 1) ≤ r n) →
      Filter.Tendsto r Filter.atTop (nhds 0) := by
    sorry
  -- every remainder is rational
  have hrat : ∀ n : ℕ, ∃ q : ℚ, r n = (q : ℝ) := by
    intro n
    induction n with
    | zero => exact ⟨1 / 2, by rw [h0]; push_cast; ring⟩
    | succ n ih =>
      obtain ⟨q, hq⟩ := ih
      rw [hstep n]
      split_ifs
      · exact ⟨q - 1 / ((2 : ℚ) ^ n - 1), by rw [hq]; push_cast; ring⟩
      · exact ⟨q, hq⟩
  have tnn : ∀ n : ℕ, (0 : ℝ) ≤ (1 : ℝ) / ((2 : ℝ) ^ n - 1) := by
    intro n
    apply div_nonneg zero_le_one
    have : (1 : ℝ) ≤ 2 ^ n := one_le_pow₀ (by norm_num)
    linarith
  intro m
  by_contra hne
  push_neg at hne
  set M := m + 1 with hM
  have htake : ∀ k : ℕ, r (M + k + 1) = r (M + k) - (1 : ℝ) / ((2 : ℝ) ^ (M + k) - 1) := by
    intro k
    rw [hstep (M + k), if_pos (hne (M + k) (by omega))]
  have hpart : ∀ k : ℕ, ∑ i ∈ Finset.range k, (1 : ℝ) / ((2 : ℝ) ^ (M + i) - 1) = r M - r (M + k) := by
    intro k
    induction k with
    | zero => simp
    | succ k ih =>
      rw [Finset.sum_range_succ, ih, ← add_assoc, htake k]
      ring
  have hlim : Filter.Tendsto (fun k => r (M + k)) Filter.atTop (nhds 0) := by
    have h := h_nostall m hne
    have h2 := (Filter.tendsto_add_atTop_iff_nat M).mpr h
    simpa [add_comm] using h2
  have hsum : HasSum (fun i : ℕ => (1 : ℝ) / ((2 : ℝ) ^ (M + i) - 1)) (r M) := by
    rw [hasSum_iff_tendsto_nat_of_nonneg (fun i => tnn (M + i))]
    simp_rw [hpart]
    simpa using (tendsto_const_nhds (x := r M)).sub hlim
  obtain ⟨q, hq⟩ := hrat M
  exact h_tail_irr M ⟨q, by rw [hsum.tsum_eq, hq]⟩
