/-! Hole `h_no_early_stall` of a merged partial proof, as a node (D-12 #5, D-29).
Statement generated by the gate from the assembly; immutable (D-3). -/

/-- one step of the fixed-point walk at `P` bits: `st = (lo, hi, ok)` brackets `2^P` times the
remainder before term `k`; a step the brackets cannot decide sets `ok` to `false`; a certain skip
checks that the remainder is under a lower bound of the tail after `k`. -/
private def opnStep (P k : ℕ) (st : ℕ × ℕ × Bool) : ℕ × ℕ × Bool :=
  let lo := st.1
  let hi := st.2.1
  let ok := st.2.2
  let tlo := 2 ^ P / (2 ^ k - 1)
  if tlo + 1 ≤ lo then (lo - (tlo + 1), hi - tlo, ok)
  else if hi < tlo then (lo, hi, ok && (hi ≤ 2 ^ (P - k) + 2 ^ (P - 2 * k - 2)))
  else (lo, hi, false)

/-- `opnLoop P a j st` runs the steps `a + 1, …, a + j` -/
private def opnLoop (P a : ℕ) : ℕ → ℕ × ℕ × Bool → ℕ × ℕ × Bool
  | 0, st => st
  | j + 1, st => opnStep P (a + j + 1) (opnLoop P a j st)

private lemma opnLoop_add (P a j : ℕ) (st : ℕ × ℕ × Bool) :
    opnLoop P 0 (a + j) st = opnLoop P a j (opnLoop P 0 a st) := by
  induction j with
  | zero => rfl
  | succ j ih =>
    rw [show a + (j + 1) = (a + j) + 1 by omega]
    simp only [opnLoop, zero_add]
    rw [ih]

private lemma opn_term_nonneg (k : ℕ) : (0 : ℝ) ≤ (1 : ℝ) / ((2 : ℝ) ^ k - 1) := by
  rcases Nat.eq_zero_or_pos k with hk | hk
  · subst hk; norm_num
  · have h2 : (1 : ℝ) < (2 : ℝ) ^ k := one_lt_pow₀ (by norm_num) (by omega)
    exact div_nonneg zero_le_one (by linarith)

private lemma opn_term_le (k : ℕ) : (1 : ℝ) / ((2 : ℝ) ^ k - 1) ≤ 2 * (1 / 2 : ℝ) ^ k := by
  rcases Nat.eq_zero_or_pos k with hk | hk
  · subst hk; norm_num
  · have h2k : (2 : ℝ) ≤ (2 : ℝ) ^ k := by
      calc (2 : ℝ) = 2 ^ 1 := by norm_num
        _ ≤ 2 ^ k := pow_le_pow_right₀ (by norm_num) hk
    have hpos : (0 : ℝ) < (2 : ℝ) ^ k / 2 := by positivity
    calc (1 : ℝ) / ((2 : ℝ) ^ k - 1) ≤ 1 / ((2 : ℝ) ^ k / 2) :=
          one_div_le_one_div_of_le hpos (by linarith)
      _ = 2 * (1 / 2 : ℝ) ^ k := by rw [one_div_pow]; field_simp

private lemma opn_summable_terms : Summable (fun k : ℕ => (1 : ℝ) / ((2 : ℝ) ^ k - 1)) :=
  (summable_geometric_two.mul_left 2).of_nonneg_of_le opn_term_nonneg opn_term_le

/-- a term is at least the sum of its first two binary digits -/
private lemma opn_term_ge (k : ℕ) (hk : 1 ≤ k) :
    (1 / 2 : ℝ) ^ k + (1 / 4 : ℝ) ^ k ≤ (1 : ℝ) / ((2 : ℝ) ^ k - 1) := by
  have h2 : (1 : ℝ) < (2 : ℝ) ^ k := one_lt_pow₀ (by norm_num) (by omega)
  have h4 : (4 : ℝ) ^ k = (2 : ℝ) ^ k * (2 : ℝ) ^ k := by rw [← mul_pow]; norm_num
  have hp : (0 : ℝ) < (2 : ℝ) ^ k := by positivity
  rw [one_div_pow, one_div_pow, h4, le_div_iff₀ (by linarith)]
  field_simp
  nlinarith

/-- the tail after `k` is at least `2^-k + 4^-(k+1)` -/
private lemma opn_tail_ge (k : ℕ) (hk : 1 ≤ k) :
    (1 / 2 : ℝ) ^ k + (1 / 4 : ℝ) ^ (k + 1) ≤ ∑' (i : ℕ), (1 : ℝ) / ((2 : ℝ) ^ (k + 1 + i) - 1) := by
  have hA : Summable (fun i : ℕ => (1 / 2 : ℝ) ^ (k + 1 + i)) :=
    summable_geometric_two.comp_injective (add_right_injective (k + 1))
  have hB : Summable (fun i : ℕ => (1 / 4 : ℝ) ^ (k + 1 + i)) :=
    (summable_geometric_of_lt_one (by norm_num) (by norm_num)).comp_injective (add_right_injective (k + 1))
  have hT : Summable (fun i : ℕ => (1 : ℝ) / ((2 : ℝ) ^ (k + 1 + i) - 1)) :=
    opn_summable_terms.comp_injective (add_right_injective (k + 1))
  have hle : ∑' (i : ℕ), ((1 / 2 : ℝ) ^ (k + 1 + i) + (1 / 4 : ℝ) ^ (k + 1 + i))
      ≤ ∑' (i : ℕ), (1 : ℝ) / ((2 : ℝ) ^ (k + 1 + i) - 1) :=
    Summable.tsum_le_tsum (fun i => opn_term_ge _ (by omega)) (hA.add hB) hT
  have hvA : ∑' (i : ℕ), (1 / 2 : ℝ) ^ (k + 1 + i) = (1 / 2 : ℝ) ^ k := by
    have : (fun i : ℕ => (1 / 2 : ℝ) ^ (k + 1 + i)) = fun i => (1 / 2 : ℝ) ^ (k + 1) * (1 / 2 : ℝ) ^ i := by
      funext i
      rw [pow_add]
    rw [this, tsum_mul_left, tsum_geometric_two, pow_succ]
    ring
  have hvB : ∑' (i : ℕ), (1 / 4 : ℝ) ^ (k + 1 + i) = (1 / 4 : ℝ) ^ (k + 1) * (1 - 1 / 4)⁻¹ := by
    have : (fun i : ℕ => (1 / 4 : ℝ) ^ (k + 1 + i)) = fun i => (1 / 4 : ℝ) ^ (k + 1) * (1 / 4 : ℝ) ^ i := by
      funext i
      rw [pow_add]
    rw [this, tsum_mul_left, tsum_geometric_of_lt_one (by norm_num) (by norm_num)]
  rw [hA.tsum_add hB, hvA, hvB] at hle
  have hq : (1 / 4 : ℝ) ^ (k + 1) ≤ (1 / 4 : ℝ) ^ (k + 1) * (1 - 1 / 4)⁻¹ := by
    have hp : (0 : ℝ) ≤ (1 / 4 : ℝ) ^ (k + 1) := by positivity
    rw [show (1 - 1 / 4 : ℝ)⁻¹ = 4 / 3 by norm_num]
    linarith
  linarith

/-- the floor `2^P / (2^k - 1)` brackets `2^P` times the term -/
private lemma opn_tlo_bounds (P k : ℕ) (hk : 1 ≤ k) :
    ((2 ^ P / (2 ^ k - 1) : ℕ) : ℝ) ≤ (2 : ℝ) ^ P * ((1 : ℝ) / ((2 : ℝ) ^ k - 1)) ∧
    (2 : ℝ) ^ P * ((1 : ℝ) / ((2 : ℝ) ^ k - 1)) < ((2 ^ P / (2 ^ k - 1) : ℕ) : ℝ) + 1 := by
  have hpos : 0 < 2 ^ k - 1 := by
    have := Nat.one_lt_two_pow (by omega : k ≠ 0)
    omega
  have hcast : (((2 ^ k - 1 : ℕ)) : ℝ) = (2 : ℝ) ^ k - 1 := by
    rw [Nat.cast_sub Nat.one_le_two_pow]
    push_cast
    ring
  have hposR : (0 : ℝ) < (2 : ℝ) ^ k - 1 := by
    rw [← hcast]
    exact_mod_cast hpos
  have h1 : 2 ^ P / (2 ^ k - 1) * (2 ^ k - 1) ≤ 2 ^ P := Nat.div_mul_le_self _ _
  have h2 : 2 ^ P < (2 ^ P / (2 ^ k - 1) + 1) * (2 ^ k - 1) := by
    rw [add_mul, one_mul]
    exact Nat.lt_div_mul_add hpos
  have h1R : ((2 ^ P / (2 ^ k - 1) : ℕ) : ℝ) * ((2 : ℝ) ^ k - 1) ≤ (2 : ℝ) ^ P := by
    rw [← hcast]
    exact_mod_cast h1
  have h2R : (2 : ℝ) ^ P < (((2 ^ P / (2 ^ k - 1) : ℕ) : ℝ) + 1) * ((2 : ℝ) ^ k - 1) := by
    rw [← hcast]
    exact_mod_cast h2
  constructor
  · rw [mul_one_div, le_div_iff₀ hposR]
    exact h1R
  · rw [mul_one_div, div_lt_iff₀ hposR]
    exact h2R

/-- `2^(a-b)` as `2^a (1/2)^b` -/
private lemma opn_pow_sub (a b : ℕ) (h : b ≤ a) : ((2 ^ (a - b) : ℕ) : ℝ) = (2 : ℝ) ^ a * (1 / 2 : ℝ) ^ b := by
  push_cast
  rw [one_div_pow, mul_one_div, eq_div_iff (by positivity), ← pow_add, Nat.sub_add_cancel h]

/-- the bracketing invariant: while `ok` holds, the brackets contain `2^2400` times the real walk's
remainder, and no stall has happened -/
private lemma opn_inv (r : ℕ → ℝ) (hr0 : r 0 = (1 : ℝ) / (2 : ℝ) ^ (20 : ℕ))
    (hr : ∀ (k : ℕ), r (k + (1 : ℕ)) =
      if (1 : ℕ) ≤ k ∧ (1 : ℝ) / ((2 : ℝ) ^ k - (1 : ℝ)) ≤ r k then r k - (1 : ℝ) / ((2 : ℝ) ^ k - (1 : ℝ))
      else r k) :
    ∀ j : ℕ, j ≤ 1092 → (opnLoop 2400 0 j (2 ^ 2380, 2 ^ 2380, true)).2.2 = true →
      (((opnLoop 2400 0 j (2 ^ 2380, 2 ^ 2380, true)).1 : ℝ) ≤ (2 : ℝ) ^ 2400 * r (j + 1) ∧
        (2 : ℝ) ^ 2400 * r (j + 1) ≤ ((opnLoop 2400 0 j (2 ^ 2380, 2 ^ 2380, true)).2.1 : ℝ)) ∧
      ∀ n, n < j → ¬ (r (n + (1 : ℕ)) < (1 : ℝ) / ((2 : ℝ) ^ (n + (1 : ℕ)) - (1 : ℝ)) ∧
        ∑' (i : ℕ), (1 : ℝ) / ((2 : ℝ) ^ (n + (2 : ℕ) + i) - (1 : ℝ)) < r (n + (1 : ℕ))) := by
  intro j
  induction j with
  | zero =>
    intro _ _
    refine ⟨?_, fun n hn => absurd hn (by omega)⟩
    simp only [opnLoop]
    rw [hr 0, if_neg (fun h => by omega), hr0]
    have h : (2 : ℝ) ^ 2400 * ((1 : ℝ) / (2 : ℝ) ^ (20 : ℕ)) = ((2 ^ 2380 : ℕ) : ℝ) := by
      push_cast
      rw [show (2 : ℝ) ^ 2400 = 2 ^ 2380 * 2 ^ 20 by rw [← pow_add]]
      field_simp
    rw [h]
    exact ⟨le_rfl, le_rfl⟩
  | succ j ih =>
    intro hj hok
    have hstep : opnLoop 2400 0 (j + 1) (2 ^ 2380, 2 ^ 2380, true)
        = opnStep 2400 (j + 1) (opnLoop 2400 0 j (2 ^ 2380, 2 ^ 2380, true)) := by
      simp only [opnLoop, zero_add]
    rw [hstep] at hok ⊢
    generalize hgen : opnLoop 2400 0 j (2 ^ 2380, 2 ^ 2380, true) = st at ih hok ⊢
    obtain ⟨lo, hi, ok⟩ := st
    have ih' := ih (by omega)
    obtain ⟨hb1, hb2⟩ := opn_tlo_bounds 2400 (j + 1) (by omega)
    simp only [opnStep] at hok ⊢
    split_ifs at hok ⊢ with h1 h2
    · -- certainly taken
      simp only at hok
      obtain ⟨⟨hlo, hhi⟩, hns⟩ := ih' hok
      simp only at hlo hhi
      have hlohi : lo ≤ hi := by exact_mod_cast hlo.trans hhi
      have htake : (1 : ℝ) / ((2 : ℝ) ^ (j + 1) - 1) ≤ r (j + 1) := by
        have hlo' : ((2 ^ 2400 / (2 ^ (j + 1) - 1) + 1 : ℕ) : ℝ) ≤ (lo : ℝ) := by exact_mod_cast h1
        push_cast at hlo'
        have : (2 : ℝ) ^ 2400 * ((1 : ℝ) / ((2 : ℝ) ^ (j + 1) - 1)) ≤ (2 : ℝ) ^ 2400 * r (j + 1) := by
          linarith
        exact le_of_mul_le_mul_left this (by positivity)
      have hr2 : r (j + 1 + 1) = r (j + 1) - (1 : ℝ) / ((2 : ℝ) ^ (j + 1) - 1) := by
        rw [hr (j + 1), if_pos ⟨by omega, htake⟩]
      refine ⟨⟨?_, ?_⟩, ?_⟩
      · rw [hr2, Nat.cast_sub h1]
        push_cast
        linarith
      · rw [hr2, Nat.cast_sub (by omega)]
        push_cast
        linarith
      · intro n hn hstall
        rcases Nat.lt_succ_iff_lt_or_eq.mp hn with hn' | rfl
        · exact hns n hn' hstall
        · exact absurd hstall.1 (not_lt.mpr htake)
    · -- certainly skipped: the remainder sits under the tail
      simp only [Bool.and_eq_true, decide_eq_true_eq] at hok
      obtain ⟨hok, hfit⟩ := hok
      obtain ⟨⟨hlo, hhi⟩, hns⟩ := ih' hok
      simp only at hlo hhi
      have hskip : r (j + 1) < (1 : ℝ) / ((2 : ℝ) ^ (j + 1) - 1) := by
        have hhi' : (hi : ℝ) < ((2 ^ 2400 / (2 ^ (j + 1) - 1) : ℕ) : ℝ) := by exact_mod_cast h2
        have : (2 : ℝ) ^ 2400 * r (j + 1) < (2 : ℝ) ^ 2400 * ((1 : ℝ) / ((2 : ℝ) ^ (j + 1) - 1)) := by
          linarith
        exact lt_of_mul_lt_mul_left this (by positivity)
      have hr2 : r (j + 1 + 1) = r (j + 1) := by
        rw [hr (j + 1), if_neg (fun h => absurd h.2 (not_le.mpr hskip))]
      refine ⟨⟨?_, ?_⟩, ?_⟩
      · rw [hr2]; exact hlo
      · rw [hr2]; exact hhi
      · intro n hn hstall
        rcases Nat.lt_succ_iff_lt_or_eq.mp hn with hn' | rfl
        · exact hns n hn' hstall
        · -- the remainder is at most the tail after n + 1
          apply absurd hstall.2
          apply not_lt.mpr
          have hfitR : (hi : ℝ) ≤ ((2 ^ (2400 - (n + 1)) : ℕ) : ℝ) + ((2 ^ (2400 - (2 * (n + 1) + 2)) : ℕ) : ℝ) := by
            have hexp : 2400 - 2 * (n + 1) - 2 = 2400 - (2 * (n + 1) + 2) := by omega
            rw [← hexp]
            exact_mod_cast hfit
          rw [opn_pow_sub _ _ (by omega), opn_pow_sub _ _ (by omega)] at hfitR
          have h4 : (1 / 2 : ℝ) ^ (2 * (n + 1) + 2) = (1 / 4 : ℝ) ^ (n + 1 + 1) := by
            rw [show 2 * (n + 1) + 2 = 2 * (n + 1 + 1) by ring, pow_mul]
            norm_num
          rw [h4] at hfitR
          have hr_le : r (n + 1) ≤ (1 / 2 : ℝ) ^ (n + 1) + (1 / 4 : ℝ) ^ (n + 1 + 1) := by
            have hm : (2 : ℝ) ^ 2400 * r (n + 1)
                ≤ (2 : ℝ) ^ 2400 * ((1 / 2 : ℝ) ^ (n + 1) + (1 / 4 : ℝ) ^ (n + 1 + 1)) := by
              rw [mul_add]
              linarith
            exact le_of_mul_le_mul_left hm (by positivity)
          calc r (n + 1) ≤ (1 / 2 : ℝ) ^ (n + 1) + (1 / 4 : ℝ) ^ (n + 1 + 1) := hr_le
            _ ≤ ∑' (i : ℕ), (1 : ℝ) / ((2 : ℝ) ^ (n + 1 + 1 + i) - 1) := opn_tail_ge (n + 1) (by omega)
            _ = ∑' (i : ℕ), (1 : ℝ) / ((2 : ℝ) ^ (n + 2 + i) - 1) := by
              apply tsum_congr
              intro i
              rw [show n + 1 + 1 + i = n + 2 + i by omega]

