/-! Hole `h_stall_forces_count` of a merged partial proof, as a node (D-12 #5, D-29).
Statement generated by the gate from the assembly; immutable (D-3). -/

/-- the binary digits of one Mersenne reciprocal: `1/(2^a-1) = Σ_j [a ∣ j+1] (1/2)^(j+1)` -/
private lemma opn_digits_one (a : ℕ) (ha : 1 ≤ a) :
    HasSum (fun j : ℕ => if a ∣ j + 1 then (1 / 2 : ℝ) ^ (j + 1) else 0) ((1 : ℝ) / ((2 : ℝ) ^ a - 1)) := by
  have hinj : Function.Injective (fun k : ℕ => a * k + (a - 1)) := by
    intro k1 k2 h
    simp only at h
    exact Nat.eq_of_mul_eq_mul_left (by omega) (Nat.add_right_cancel h)
  rw [← hinj.hasSum_iff]
  · have hdvd : ∀ k : ℕ, a ∣ a * k + (a - 1) + 1 := fun k =>
      ⟨k + 1, by rw [add_assoc, Nat.sub_add_cancel ha]; ring⟩
    have hfun : ((fun j : ℕ => if a ∣ j + 1 then (1 / 2 : ℝ) ^ (j + 1) else 0) ∘ (fun k : ℕ => a * k + (a - 1)))
        = fun k : ℕ => ((1 / 2 : ℝ) ^ a) ^ (k + 1) := by
      funext k
      simp only [Function.comp, hdvd k, if_true]
      rw [← pow_mul]
      congr 1
      rw [add_assoc, Nat.sub_add_cancel ha]
      ring
    rw [hfun]
    have hr0 : (0 : ℝ) ≤ (1 / 2 : ℝ) ^ a := by positivity
    have hr1 : (1 / 2 : ℝ) ^ a < 1 := pow_lt_one₀ (by norm_num) (by norm_num) (by omega)
    have hg := (hasSum_geometric_of_lt_one hr0 hr1).mul_left ((1 / 2 : ℝ) ^ a)
    have h2 : (1 : ℝ) < (2 : ℝ) ^ a := one_lt_pow₀ (by norm_num) (by omega)
    have hne : (2 : ℝ) ^ a - 1 ≠ 0 := by linarith
    have hval : (1 : ℝ) / ((2 : ℝ) ^ a - 1) = (1 / 2 : ℝ) ^ a * (1 - (1 / 2 : ℝ) ^ a)⁻¹ := by
      rw [one_div_pow]
      field_simp
    have hfun2 : (fun k : ℕ => ((1 / 2 : ℝ) ^ a) ^ (k + 1)) = fun k => (1 / 2 : ℝ) ^ a * ((1 / 2 : ℝ) ^ a) ^ k := by
      funext k
      ring
    rw [hfun2, hval]
    exact hg
  · intro j hj
    simp only [ite_eq_right_iff]
    intro hdj
    exfalso
    apply hj
    obtain ⟨q, hq⟩ := hdj
    rcases q with _ | q
    · omega
    · refine ⟨q, ?_⟩
      simp only
      rw [Nat.mul_succ] at hq
      generalize a * q = w at hq ⊢
      omega

/-- the digits of a finite sum of Mersenne reciprocals, weighted by divisor counts -/
private lemma opn_digits (S : Finset ℕ) (hS : ∀ a ∈ S, 1 ≤ a) :
    HasSum (fun j : ℕ => (1 / 2 : ℝ) ^ (j + 1) * ((S.filter (fun a => a ∣ j + 1)).card : ℝ))
      (∑ a ∈ S, (1 : ℝ) / ((2 : ℝ) ^ a - 1)) := by
  have h := hasSum_sum (fun a (ha : a ∈ S) => opn_digits_one a (hS a ha))
  convert h using 1
  funext j
  rw [Finset.sum_ite, Finset.sum_const_zero, add_zero, Finset.sum_const, nsmul_eq_mul]
  ring


private lemma opn_term_nonneg (k : ℕ) : (0 : ℝ) ≤ (1 : ℝ) / ((2 : ℝ) ^ k - 1) := by
  rcases Nat.eq_zero_or_pos k with hk | hk
  · subst hk; norm_num
  · have h2 : (1 : ℝ) < (2 : ℝ) ^ k := one_lt_pow₀ (by norm_num) (by omega)
    exact div_nonneg zero_le_one (by linarith)

private lemma opn_term_le (k : ℕ) : (1 : ℝ) / ((2 : ℝ) ^ k - 1) ≤ 2 * (1 / 2 : ℝ) ^ k := by
  rcases Nat.eq_zero_or_pos k with hk | hk
  · subst hk; norm_num
  · have h2k : (2 : ℝ) ≤ (2 : ℝ) ^ k := by
      calc (2 : ℝ) = 2 ^ 1 := by norm_num
        _ ≤ 2 ^ k := pow_le_pow_right₀ (by norm_num) hk
    have hpos : (0 : ℝ) < (2 : ℝ) ^ k / 2 := by positivity
    calc (1 : ℝ) / ((2 : ℝ) ^ k - 1) ≤ 1 / ((2 : ℝ) ^ k / 2) :=
          one_div_le_one_div_of_le hpos (by linarith)
      _ = 2 * (1 / 2 : ℝ) ^ k := by rw [one_div_pow]; field_simp

/-- every term strictly exceeds the binary term -/
private lemma opn_term_gt (k : ℕ) (hk : 1 ≤ k) : (1 / 2 : ℝ) ^ k < (1 : ℝ) / ((2 : ℝ) ^ k - 1) := by
  have h2 : (1 : ℝ) < (2 : ℝ) ^ k := one_lt_pow₀ (by norm_num) (by omega)
  rw [one_div_pow]
  exact one_div_lt_one_div_of_lt (by linarith) (by linarith)

private lemma opn_summable_terms : Summable (fun k : ℕ => (1 : ℝ) / ((2 : ℝ) ^ k - 1)) :=
  (summable_geometric_two.mul_left 2).of_nonneg_of_le opn_term_nonneg opn_term_le

theorem variant_cce9b284__h3 : ∀ (L p : ℕ) (r : ℕ → ℝ),
  r (0 : ℕ) = (↑p : ℝ) / (2 : ℝ) ^ L →
    (∀ (k : ℕ),
        r (k + (1 : ℕ)) =
          if (1 : ℕ) ≤ k ∧ (1 : ℝ) / ((2 : ℝ) ^ k - (1 : ℝ)) ≤ r k then r k - (1 : ℝ) / ((2 : ℝ) ^ k - (1 : ℝ))
          else r k) →
      ∀ (n m : ℕ),
        L ≤ n →
          n < m →
            m + (10 : ℕ) ≤ (2 : ℕ) * n →
              r (n + (1 : ℕ)) < (1 : ℝ) / ((2 : ℝ) ^ (n + (1 : ℕ)) - (1 : ℝ)) ∧
                  ∑' (i : ℕ), (1 : ℝ) / ((2 : ℝ) ^ (n + (2 : ℕ) + i) - (1 : ℝ)) < r (n + (1 : ℕ)) →
                (99 / 100 : ℝ) <
                  ∑' (i : ℕ),
                    (1 / 2 : ℝ) ^ (i + (1 : ℕ)) *
                      (↑{a : ℕ |
                              (1 : ℕ) ≤ a ∧
                                a ≤ n ∧ (1 : ℝ) / ((2 : ℝ) ^ a - (1 : ℝ)) ≤ r a ∧ a ∣ m + i + (1 : ℕ)}.ncard :
                        ℝ) := by
  intro L p r hr0 hr n m hLn hnm hm10 hst
  obtain ⟨hst1, hst2⟩ := hst
  -- the indices taken up to n
  set S : Finset ℕ := (Finset.range (n + 1)).filter
    (fun a => (1 : ℕ) ≤ a ∧ (1 : ℝ) / ((2 : ℝ) ^ a - (1 : ℝ)) ≤ r a) with hS_def
  have hS1 : ∀ a ∈ S, 1 ≤ a := by
    intro a ha
    rw [hS_def] at ha
    exact (Finset.mem_filter.mp ha).2.1
  -- the statement's sets are filters of S
  have hset : ∀ j : ℕ, ({a : ℕ | (1 : ℕ) ≤ a ∧ a ≤ n ∧ (1 : ℝ) / ((2 : ℝ) ^ a - (1 : ℝ)) ≤ r a ∧ a ∣ j} : Set ℕ)
      = ↑(S.filter (fun a => a ∣ j)) := by
    intro j
    ext a
    simp only [Set.mem_setOf_eq, Finset.mem_coe, Finset.mem_filter, Finset.mem_range, hS_def]
    constructor
    · rintro ⟨h1, h2, h3, h4⟩
      exact ⟨⟨by omega, h1, h3⟩, h4⟩
    · rintro ⟨⟨h0, h1, h3⟩, h4⟩
      exact ⟨h1, by omega, h3, h4⟩
  have hcard : ∀ j : ℕ,
      (({a : ℕ | (1 : ℕ) ≤ a ∧ a ≤ n ∧ (1 : ℝ) / ((2 : ℝ) ^ a - (1 : ℝ)) ≤ r a ∧ a ∣ j} : Set ℕ).ncard : ℝ)
      = ((S.filter (fun a => a ∣ j)).card : ℝ) := by
    intro j
    rw [hset j, Set.ncard_coe_finset]
  -- the partial sums of the walk
  set f : ℕ → ℝ := fun a => if (1 : ℕ) ≤ a ∧ (1 : ℝ) / ((2 : ℝ) ^ a - (1 : ℝ)) ≤ r a
    then (1 : ℝ) / ((2 : ℝ) ^ a - (1 : ℝ)) else 0 with hf_def
  have hf_step : ∀ a, f a = r a - r (a + 1) := by
    intro a
    rw [hr a]
    simp only [hf_def]
    split_ifs <;> ring
  have hpartial : ∀ N, ∑ a ∈ Finset.range N, f a = r 0 - r N := by
    intro N
    induction N with
    | zero => simp
    | succ N ih => rw [Finset.sum_range_succ, ih, hf_step N]; ring
  have hSsum : ∑ a ∈ S, (1 : ℝ) / ((2 : ℝ) ^ a - 1) = r 0 - r (n + 1) := by
    rw [← hpartial (n + 1), hS_def, Finset.sum_filter]
  -- the binary digits of the taken sum
  have hdig := opn_digits S hS1
  rw [hSsum] at hdig
  set h : ℕ → ℝ := fun j => (1 / 2 : ℝ) ^ (j + 1) * ((S.filter (fun a => a ∣ j + 1)).card : ℝ) with hh_def
  have hhsum : Summable h := hdig.summable
  have hhtot : ∑' j, h j = r 0 - r (n + 1) := hdig.tsum_eq
  have hsplit := Summable.sum_add_tsum_nat_add m hhsum
  -- the tail from m is (1/2)^m times the weighted count W
  set W : ℝ := ∑' (i : ℕ), (1 / 2 : ℝ) ^ (i + (1 : ℕ)) *
      (({a : ℕ | (1 : ℕ) ≤ a ∧ a ≤ n ∧ (1 : ℝ) / ((2 : ℝ) ^ a - (1 : ℝ)) ≤ r a ∧ a ∣ m + i + (1 : ℕ)} : Set ℕ).ncard : ℝ)
    with hW_def
  have h2m : (2 : ℝ) ^ m * (1 / 2 : ℝ) ^ m = 1 := by rw [← mul_pow]; norm_num
  have hWfun : (fun i : ℕ => (1 / 2 : ℝ) ^ (i + (1 : ℕ)) *
      (({a : ℕ | (1 : ℕ) ≤ a ∧ a ≤ n ∧ (1 : ℝ) / ((2 : ℝ) ^ a - (1 : ℝ)) ≤ r a ∧ a ∣ m + i + (1 : ℕ)} : Set ℕ).ncard : ℝ))
      = fun i => (2 : ℝ) ^ m * h (i + m) := by
    funext i
    rw [hcard]
    simp only [hh_def]
    rw [show i + m + 1 = m + i + 1 by omega]
    rw [show (1 / 2 : ℝ) ^ (m + i + 1) = (1 / 2 : ℝ) ^ m * (1 / 2 : ℝ) ^ (i + 1) by
      rw [show m + i + 1 = m + (i + 1) by omega, pow_add]]
    linear_combination (-((1 / 2 : ℝ) ^ (i + 1) * ((S.filter (fun a => a ∣ m + i + 1)).card : ℝ))) * h2m
  have hWsum : Summable (fun i : ℕ => h (i + m)) := hhsum.comp_injective (add_left_injective m)
  have hW : W = (2 : ℝ) ^ m * ∑' i, h (i + m) := by
    rw [hW_def, hWfun, tsum_mul_left]
  -- the head is the natural number K, divided by 2^m
  set K : ℕ := ∑ j ∈ Finset.range m, 2 ^ (m - (j + 1)) * (S.filter (fun a => a ∣ j + 1)).card with hK_def
  have hK : (K : ℝ) = (2 : ℝ) ^ m * ∑ j ∈ Finset.range m, h j := by
    rw [hK_def, Finset.mul_sum]
    push_cast
    refine Finset.sum_congr rfl (fun j hj => ?_)
    have hjm : j + 1 ≤ m := Finset.mem_range.mp hj
    simp only [hh_def]
    have hsplitj : (2 : ℝ) ^ m = (2 : ℝ) ^ (m - (j + 1)) * (2 : ℝ) ^ (j + 1) := by
      rw [← pow_add, Nat.sub_add_cancel hjm]
    rw [hsplitj, one_div_pow]
    field_simp
  -- 2^m times the target is a natural number
  have hx : (2 : ℝ) ^ m * r 0 = ((p * 2 ^ (m - L) : ℕ) : ℝ) := by
    rw [hr0]
    push_cast
    have hsplitL : (2 : ℝ) ^ m = (2 : ℝ) ^ (m - L) * (2 : ℝ) ^ L := by
      rw [← pow_add, Nat.sub_add_cancel (by omega)]
    rw [hsplitL]
    field_simp
  -- so W is an integer minus 2^m r(n+1)
  have hWeq : W = ((p * 2 ^ (m - L) : ℕ) : ℝ) - (K : ℝ) - (2 : ℝ) ^ m * r (n + 1) := by
    rw [hW, hK, ← hx]
    have : ∑' i, h (i + m) = (r 0 - r (n + 1)) - ∑ j ∈ Finset.range m, h j := by
      linarith [hsplit, hhtot]
    rw [this]
    ring
  -- the stall pins 2^m r(n+1) just above 2^(m-n-1)
  have hnm1 : n + 1 ≤ m := hnm
  have hsplitn : (2 : ℝ) ^ m = (2 : ℝ) ^ (m - (n + 1)) * (2 : ℝ) ^ (n + 1) := by
    rw [← pow_add, Nat.sub_add_cancel hnm1]
  have hlow : (2 : ℝ) ^ (m - (n + 1)) < (2 : ℝ) ^ m * r (n + 1) := by
    have hgeo : Summable (fun i : ℕ => (1 / 2 : ℝ) ^ (n + 2 + i)) :=
      summable_geometric_two.comp_injective (add_right_injective (n + 2))
    have hts : Summable (fun i : ℕ => (1 : ℝ) / ((2 : ℝ) ^ (n + 2 + i) - 1)) :=
      opn_summable_terms.comp_injective (add_right_injective (n + 2))
    have hlt : ∑' (i : ℕ), (1 / 2 : ℝ) ^ (n + 2 + i) < ∑' (i : ℕ), (1 : ℝ) / ((2 : ℝ) ^ (n + 2 + i) - 1) :=
      Summable.tsum_lt_tsum (i := 0) (fun i => (opn_term_gt (n + 2 + i) (by omega)).le)
        (opn_term_gt (n + 2) (by omega)) hgeo hts
    have hfun : (fun i : ℕ => (1 / 2 : ℝ) ^ (n + 2 + i)) = fun i => (1 / 2 : ℝ) ^ (n + 2) * (1 / 2 : ℝ) ^ i := by
      funext i
      rw [pow_add]
    have hval : ∑' (i : ℕ), (1 / 2 : ℝ) ^ (n + 2 + i) = (1 / 2 : ℝ) ^ (n + 1) := by
      rw [hfun, tsum_mul_left, tsum_geometric_two, pow_succ]
      ring
    have hr1 : (1 / 2 : ℝ) ^ (n + 1) < r (n + 1) := by linarith
    have hid : (2 : ℝ) ^ (m - (n + 1)) = (2 : ℝ) ^ m * (1 / 2 : ℝ) ^ (n + 1) := by
      rw [hsplitn, one_div_pow]
      field_simp
    rw [hid]
    exact mul_lt_mul_of_pos_left hr1 (by positivity)
  have hhigh : (2 : ℝ) ^ m * r (n + 1) < (2 : ℝ) ^ (m - (n + 1)) + 1 / 2048 := by
    have h1 : (2 : ℝ) ^ m * r (n + 1) < (2 : ℝ) ^ m * ((1 : ℝ) / ((2 : ℝ) ^ (n + 1) - 1)) :=
      mul_lt_mul_of_pos_left hst1 (by positivity)
    have hpos : (0 : ℝ) < (2 : ℝ) ^ (n + 1) - 1 := by
      have : (1 : ℝ) < (2 : ℝ) ^ (n + 1) := one_lt_pow₀ (by norm_num) (by omega)
      linarith
    have hid : (2 : ℝ) ^ m * ((1 : ℝ) / ((2 : ℝ) ^ (n + 1) - 1))
        = (2 : ℝ) ^ (m - (n + 1)) + (2 : ℝ) ^ (m - (n + 1)) / ((2 : ℝ) ^ (n + 1) - 1) := by
