      rw [pow_succ]
      have : (1 : ℝ) < (2 : ℝ) ^ n := one_lt_pow₀ (by norm_num) (by omega)
      linarith
    have hpn : (0 : ℝ) < (2 : ℝ) ^ n := by positivity
    have hgap : (2 : ℝ) ^ (m - (n + 1)) / ((2 : ℝ) ^ (n + 1) - 1) ≤ 1 / 2048 := by
      calc (2 : ℝ) ^ (m - (n + 1)) / ((2 : ℝ) ^ (n + 1) - 1) ≤ (2 : ℝ) ^ (m - (n + 1)) / (2 : ℝ) ^ n :=
            div_le_div_of_nonneg_left (by positivity) hpn hn2.le
